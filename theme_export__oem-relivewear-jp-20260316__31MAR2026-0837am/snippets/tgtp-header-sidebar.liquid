<div class="sidebar-bg" style="visibility: hidden;"></div>
<div class="sidebar">
  {% if section.settings.mobile_hamburger_icon_position == 'right' %}
    <div class="sidebar__close">
      <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M29.5612 27.4388C29.7006 27.5781 29.8111 27.7436 29.8866 27.9257C29.962 28.1077 30.0008 28.3029 30.0008 28.5C30.0008 28.6971 29.962 28.8923 29.8866 29.0743C29.8111 29.2564 29.7006 29.4219 29.5612 29.5613C29.4219 29.7006 29.2564 29.8112 29.0743 29.8866C28.8922 29.962 28.6971 30.0008 28.5 30.0008C28.3029 30.0008 28.1077 29.962 27.9256 29.8866C27.7435 29.8112 27.5781 29.7006 27.4387 29.5613L15 17.1206L2.56123 29.5613C2.27977 29.8427 1.89803 30.0008 1.49998 30.0008C1.10193 30.0008 0.720191 29.8427 0.43873 29.5613C0.157269 29.2798 -0.000854484 28.8981 -0.000854492 28.5C-0.0008545 28.102 0.157269 27.7202 0.43873 27.4388L12.8794 15L0.43873 2.56125C0.157269 2.27979 -0.000854492 1.89805 -0.000854492 1.5C-0.000854492 1.10195 0.157269 0.720212 0.43873 0.438751C0.720191 0.15729 1.10193 -0.000833511 1.49998 -0.000833511C1.89803 -0.000833511 2.27977 0.15729 2.56123 0.438751L15 12.8794L27.4387 0.438751C27.7202 0.15729 28.1019 -0.000833519 28.5 -0.000833511C28.898 -0.000833504 29.2798 0.15729 29.5612 0.438751C29.8427 0.720212 30.0008 1.10195 30.0008 1.5C30.0008 1.89805 29.8427 2.27979 29.5612 2.56125L17.1206 15L29.5612 27.4388Z" fill="white"/>
      </svg>      
    </div>
  {% endif %}
  <div class="sidebar-menu">
    <div class="sidebar-menu__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
        {%- when 'account_menu' -%}
          <section id="{{ block.id }}" class="account-section">
            {%- if block.settings.account_menu_title_enable -%}
              <p class="section__title {% if block.settings.border_enable %}section__title--border{% endif %}">
                アカウント
              </p>
            {%- endif -%}
            <div class="section__contents">
              <div class="account-menu {% if block.settings.border_enable %}account-menu--border{% endif %}">
                {% unless customer %}
                  {% if block.settings.separate_login_register_btn %}
                    <a
                      href="/account/login"
                      class="account-menu__btn {% if block.settings.display_frame_lines %}account-menu__btn--border{% endif %} {% if block.settings.login_btn_inversion %}account-menu__btn--login{% endif %}"
                    >
                      <span>ログイン</span>
                    </a>
                    <a
                      href="/account/register"
                      class="account-menu__btn {% if block.settings.display_frame_lines %}account-menu__btn--border{% endif %}"
                    >
                      <span>新規登録</span>
                    </a>
                  {% else %}
                    <a
                      href="{{ routes.account_url }}"
                      class="account-menu__btn {% if block.settings.display_frame_lines %}account-menu__btn--border{% endif %}"
                    >
                      {{ 'icon-user.svg' | inline_asset_content }}<span>ログイン・新規登録</span>
                    </a>
                  {% endif %}
                {% else %}
                  <a
                    href="/account"
                    class="account-menu__btn {% if block.settings.display_frame_lines %}account-menu__btn--border{% endif %}"
                  >
                    {{ 'icon-user.svg' | inline_asset_content }}<span>マイページ</span>
                  </a>
                {% endunless %}
              </div>
            </div>
          </section>
          <style>
            .account-menu__btn--border {
              border: 1px solid {{ block.settings.account_btn_txt_color }};
            }
            .account-menu__btn {
              border-radius: {{ block.settings.account_btn_radius }}px;
              color: {{ block.settings.account_btn_txt_color }};
              background-color: {{ block.settings.account_btn_bg_color }};
            }
            .account-menu__btn svg {
              margin-right: 10px;
            }
            .account-menu__btn svg, .account-menu__btn path {
              fill: {{ block.settings.account_btn_txt_color }};
            }
            .account-menu__btn--login {
              color: {{ block.settings.account_btn_bg_color }};
              background-color: {{ block.settings.account_btn_txt_color }};
            }
          </style>
        {%- when 'logo' -%}
          <div id="{{ block.id }}" class="sidebar-logo">
            <a
              href="{{ routes.root_url }}"
              class="sidebar-logo__link sidebar-logo__link--{{ section.settings.logo_horizon_position }}"
            >
              {%- if block.settings.sidebar_logo != blank -%}
                <img
                  src="{{ block.settings.sidebar_logo | image_url: width: block.settings.sidebar_logo.width }}"
                  srcset="{{ block.settings.sidebar_logo | image_url: width: block.settings.sidebar_logo.width }} 1x, {{ block.settings.logo | image_url: width: block.settings.sidebar_logo.width }} 2x"
                  width="{{ block.settings.sidebar_logo.width }}"
                  height="{{ block.settings.sidebar_logo.height }}"
                  alt="{{ block.settings.sidebar_logo.alt | default: shop.name | escape }}"
                  class="sidebar-logo__img"
                >
              {%- else -%}
                <span>{{ shop.name }}</span>
              {%- endif -%}
            </a>
          </div>
        {%- when 'banner' -%}
          {%- if block.settings.image != blank -%}
          <div id="{{ block.id }}" class="banner-wrapper">
            <a class="banner" href="{{ block.settings.url }}"><img src="{{ block.settings.image | image_url: width: block.settings.image.width }}"></a>
          </div>
        {%- endif -%}
        {%- when 'menu' -%}
          {%- assign main_menu_handle = block.settings.menu | default: 'main-menu' -%}
        {%- assign main_menu = linklists[main_menu_handle] -%}
        <section id="{{ block.id }}">
          {%- if block.settings.title_enable -%}
            <p class="section__title {% if section.settings.border_enable %}section__title--border{% endif %}">
              {{ block.settings.menu_title }}
            </p>
          {%- endif -%}
          <nav class="section__contents {% if section.settings.border_enable %}sidebar__menu--border{% endif %}">
            {%- for link in main_menu.links -%}
              <div class="section__contents--first {% if section.settings.border_enable %}sidebar__link--border{% endif %}">
                {%- if link.links != blank -%}
                  <button
                    class="sidebar__link sidebar__link--first"
                    {% if link.links != blank %}
                      aria-expanded="false"
                    {% endif %}
                  >
                    {{- link.title | escape -}}
                    <div class="acordion">
                      {%- if section.settings.acordion_icon == 'caret' -%}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          height="24px"
                          viewBox="0 -960 960 960"
                          width="24px"
                          class="acordion-icon"
                        >
                          <path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z"/>
                        </svg>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          height="24px"
                          viewBox="0 -960 960 960"
                          width="24px"
                          class="acordion-icon acordion-icon--active"
                        >
                          <path d="M480-528 296-344l-56-56 240-240 240 240-56 56-184-184Z"/>
                        </svg>
                      {%- endif -%}

                      {%- if section.settings.acordion_icon == 'plus_minus' -%}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          height="24px"
                          viewBox="0 -960 960 960"
                          width="24px"
                          class="acordion-icon"
                        >
                          <path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z"/>
                        </svg>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          height="24px"
                          viewBox="0 -960 960 960"
                          width="24px"
                          class="acordion-icon acordion-icon--active"
                        >
                          <path d="M200-440v-80h560v80H200Z"/>
                        </svg>
                      {%- endif -%}
                    </div>
                  </button>

                  <div class="section__contents--second">
                    {%- for sub_link in link.links -%}
                      {%- if sub_link.links != blank -%}
                        <button
                          class="sidebar__link sidebar__link--second"
                          {% if sub_link.links != blank %}
                            aria-expanded="false"
                          {% endif %}
                        >
                          {{- sub_link.title | escape -}}
                          <div class="acordion">
                            {%- case section.settings.acordion_icon -%}
                              {%- when 'caret' -%}
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  height="24px"
                                  viewBox="0 -960 960 960"
                                  width="24px"
                                  class="acordion-icon"
                                >
                                  <path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z"/>
                                </svg>
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  height="24px"
                                  viewBox="0 -960 960 960"
                                  width="24px"
                                  class="acordion-icon acordion-icon--active"
                                >
                                  <path d="M480-528 296-344l-56-56 240-240 240 240-56 56-184-184Z"/>
                                </svg>

                              {%- when 'plus_minus' -%}
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  height="24px"
                                  viewBox="0 -960 960 960"
                                  width="24px"
                                  class="acordion-icon"
                                >
                                  <path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z"/>
                                </svg>
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  height="24px"
                                  viewBox="0 -960 960 960"
                                  width="24px"
                                  class="acordion-icon acordion-icon--active"
                                >
                                  <path d="M200-440v-80h560v80H200Z"/>
                                </svg>
                            {%- endcase -%}
                          </div>
                        </button>

                        <div class="section__contents--third">
                          {%- for sub_sub_link in sub_link.links -%}
                            <a
                              href="{{ sub_sub_link.url }}"
                              class="sidebar__link sidebar__link--third"
                            >
                              {{- sub_sub_link.title | escape -}}
                              {%- if section.settings.enable_link_icon -%}
                                <div class="triangle">
                                  <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    height="24px"
                                    viewBox="0 -960 960 960"
                                    width="24px"
                                  >
                                    <path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"/>
                                  </svg>
                                </div>
                              {%- endif -%}
                            </a>
                          {%- endfor -%}
                        </div>
                      {%- else -%}
                        <a
                          href="{{ sub_link.url }}"
                          class="sidebar__link sidebar__link--second"
                        >
                          {{- sub_link.title | escape -}}
                          {%- if section.settings.enable_link_icon -%}
                            <div class="triangle">
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                height="24px"
                                viewBox="0 -960 960 960"
                                width="24px"
                              >
                                <path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"/>
                              </svg>
                            </div>
                          {%- endif -%}
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <a
                    href="{{ link.url }}"
                    class="sidebar__link sidebar__link--first"
                  >
                    <span class="SectionHeader__Heading-text notitalic">{{ link.title | escape }}</span>
                    {%- if section.settings.enable_link_icon -%}
                      <div class="triangle">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          height="24px"
                          viewBox="0 -960 960 960"
                          width="24px"
                        >
                          <path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"/>
                        </svg>
                      </div>
                    {%- endif -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </nav>
        </section>
        {%- when 'search_bar' -%}
          <div id="{{ block.id }}">
            <form action="/search" method="get" class="search-form--sidebar">
              <div class="searchbar searchbar--sidebar">
                <input type="text" name="q" aria-label="Search">
                <button type="submit" class="icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19.5306 18.4693L14.8365 13.7762C16.1971 12.1428 16.8755 10.0478 16.7307 7.92691C16.5859 5.80604 15.629 3.82265 14.0591 2.38932C12.4892 0.955989 10.4271 0.183083 8.30188 0.231383C6.17663 0.279683 4.15181 1.14547 2.64864 2.64864C1.14547 4.15181 0.279683 6.17663 0.231383 8.30188C0.183083 10.4271 0.955989 12.4892 2.38932 14.0591C3.82265 15.629 5.80604 16.5859 7.92691 16.7307C10.0478 16.8755 12.1428 16.1971 13.7762 14.8365L18.4693 19.5306C18.539 19.6003 18.6218 19.6556 18.7128 19.6933C18.8038 19.731 18.9014 19.7504 19 19.7504C19.0985 19.7504 19.1961 19.731 19.2871 19.6933C19.3782 19.6556 19.4609 19.6003 19.5306 19.5306C19.6003 19.4609 19.6556 19.3782 19.6933 19.2871C19.731 19.1961 19.7504 19.0985 19.7504 19C19.7504 18.9014 19.731 18.8038 19.6933 18.7128C19.6556 18.6218 19.6003 18.539 19.5306 18.4693ZM1.74997 8.49997C1.74997 7.16495 2.14585 5.8599 2.88755 4.74987C3.62925 3.63984 4.68346 2.77467 5.91686 2.26378C7.15026 1.75289 8.50746 1.61922 9.81683 1.87967C11.1262 2.14012 12.3289 2.78299 13.2729 3.727C14.2169 4.671 14.8598 5.87374 15.1203 7.18311C15.3807 8.49248 15.2471 9.84968 14.7362 11.0831C14.2253 12.3165 13.3601 13.3707 12.2501 14.1124C11.14 14.8541 9.83499 15.25 8.49997 15.25C6.71037 15.248 4.99463 14.5362 3.72919 13.2708C2.46375 12.0053 1.75196 10.2896 1.74997 8.49997Z" fill="#212121"/></svg>
                </button>
              </div>
            </form>
          </div>
        {%- endcase -%}
        <style>
          #{{ block.id }} {
            margin-top: {{ block.settings.margin_top }}px;
          }
        </style>
      {%- endfor -%}
    </div>
  </div>
  {% if section.settings.mobile_hamburger_icon_position == 'left' %}
    <div class="sidebar__close">
      <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M29.5612 27.4388C29.7006 27.5781 29.8111 27.7436 29.8866 27.9257C29.962 28.1077 30.0008 28.3029 30.0008 28.5C30.0008 28.6971 29.962 28.8923 29.8866 29.0743C29.8111 29.2564 29.7006 29.4219 29.5612 29.5613C29.4219 29.7006 29.2564 29.8112 29.0743 29.8866C28.8922 29.962 28.6971 30.0008 28.5 30.0008C28.3029 30.0008 28.1077 29.962 27.9256 29.8866C27.7435 29.8112 27.5781 29.7006 27.4387 29.5613L15 17.1206L2.56123 29.5613C2.27977 29.8427 1.89803 30.0008 1.49998 30.0008C1.10193 30.0008 0.720191 29.8427 0.43873 29.5613C0.157269 29.2798 -0.000854484 28.8981 -0.000854492 28.5C-0.0008545 28.102 0.157269 27.7202 0.43873 27.4388L12.8794 15L0.43873 2.56125C0.157269 2.27979 -0.000854492 1.89805 -0.000854492 1.5C-0.000854492 1.10195 0.157269 0.720212 0.43873 0.438751C0.720191 0.15729 1.10193 -0.000833511 1.49998 -0.000833511C1.89803 -0.000833511 2.27977 0.15729 2.56123 0.438751L15 12.8794L27.4387 0.438751C27.7202 0.15729 28.1019 -0.000833519 28.5 -0.000833511C28.898 -0.000833504 29.2798 0.15729 29.5612 0.438751C29.8427 0.720212 30.0008 1.10195 30.0008 1.5C30.0008 1.89805 29.8427 2.27979 29.5612 2.56125L17.1206 15L29.5612 27.4388Z" fill="white"/>
      </svg>      
    </div>
  {% endif %}
</div>

<style>
  {%- if section.settings.mobile_hamburger_icon_position == "right" -%}
    .sidebar {
      right: 0;
      transform: translateX(100vw);
    }
  {%- else -%}
    .sidebar {
      left: 0;
      transform: translateX(-100vw);
    }
  {%- endif -%}
  {%- if section.settings.sidebar_logo_enable -%}
    .sidebar-logo__link--top {
      margin-bottom: {{ section.settings.sidebar_logo_margin }}px;
    }
    .sidebar-logo__link--bottom {
      margin-top: {{ section.settings.sidebar_logo_margin }}px;
    }
  {%- endif -%}
  {%- if section.settings.sidebar_logo != blank -%}
    .sidebar-logo__img {
      width: {{ section.settings.logo_size }}px;
      height: auto;
    }
  {%- endif -%}
  .sidebar-logo--border {
    border-bottom: 1px solid {{ section.settings.menu_border_color }};
  }
  .account-menu--border {
    border-bottom: 1px solid {{ section.settings.menu_border_color }};
  }
  .section__title--border {
    border-bottom: 1px solid {{ section.settings.menu_border_color }};
  }
  .sidebar__link--border {
    border-bottom: 1px solid {{ section.settings.menu_border_color }};
  }
  .sidebar__menu--border {
    border-top: 1px solid {{ section.settings.menu_border_color }};
  }
  .section__title {
    color: {{ section.settings.menu_title_txt_color }};
    background-color: {{ section.settings.menu_title_bg_color }};
  }
  .acordion {
    fill: {{ section.settings.acordion_icon_color }};
  }
  .triangle {
    fill: {{ section.settings.link_icon_color }};
  }

  .sidebar__link--first {
    color: {{ section.settings.main_txt_color }};
    background-color: {{ section.settings.main_bg_color }};
  }

  .sidebar__link--second {
    color: {{ section.settings.second_txt_color }};
    background-color: {{ section.settings.second_bg_color }};
    padding: 8px 16px;
    min-height: 20px;
  }

  .sidebar__link--third {
    color: {{ section.settings.third_txt_color }};
    background-color: {{ section.settings.third_bg_color }};
    padding: 8px 16px;
    min-height: 20px;
  }

  .section__contents--second {
    margin-left: {{ section.settings.second_layer_margin_left }}px;
  }

  .section__contents--third {
    margin-left: {{ section.settings.third_layer_margin_left }}px;
  }

  section.language-handle .menu-drawer__localization.header-localization {
    padding: 15px;
  }

  .sidebar-menu__inner {
    padding: {{ section.settings.sidebar_padding_top }}px {{ section.settings.sidebar_padding_x }}px {{ section.settings.sidebar_padding_bottom }}px;
  }
</style>
