{% comment %}
  Renders product buy-buttons.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} product form id.
  - section_id: {String} id of section to which this snippet belongs.
  - show_pickup_availability: {Boolean} for the pickup availability. If true the pickup availability is rendered, false - not rendered (optional).

  Usage:
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% endcomment %}


{% comment %} 時間制御 {% endcomment %}
{% comment %} メタフィールドがある場合に比較 {% endcomment %}
{% assign before_sale = false %}
{% assign disable_sale = false %}
{% if shop.metafields.time.now %}
  {% comment %} 開始日時 {% endcomment %}
  {% if product.metafields.datetime.start %}
    {% assign timenow = shop.metafields.time.now | date: '%s' %}
    {% assign producttime_start = product.metafields.datetime.start | date: '%s' %}
    {% if timenow < producttime_start %}
      {% assign before_sale = true %}
    {% endif %}
  {% endif %}
  {% comment %} 終了日時 {% endcomment %}
  {% if product.metafields.datetime.end %}
    {% assign timenow = shop.metafields.time.now | date: '%s' %}
    {% assign producttime = product.metafields.datetime.end | date: '%s' %}
    {% if timenow >= producttime %}
      {% assign disable_sale = true %}
    {% endif %}
  {% endif %}
{% endif %}

{% comment %} 特殊要件 {% endcomment %}
{% comment %} 買い合わせ商品、チケット側の設定日と現在時刻を比較。チケットの日程が現在日時のn日前を超えていたら、商品側を購入不可にする {% endcomment %}
{% comment %}  {% endcomment %}
{% assign disable_sale_days_ago = false %}
{% if product.tags contains '_会場引換:商品' %}

  {% comment %} カートに入っているチケットの日時を取得 {% endcomment %}
  {% assign ticket_date_minus = '' %}
  {% assign flug = false %}
  {% assign error = false %}
  {% assign minus_day = '' %}

  {% for item in cart.items %}
    {% assign minus_num = '' %}
    {% if item.product.tags contains '_会場引換:受付枠' or item.product.tags contains '_会場引換:受付枠_単体複数購入可' %}
      {% if item.product.metafields.ticket.date != blank %}
        {% if flug == true %}
          {% comment %} 2つ以上チケットが入っていた場合はNGに {% endcomment %}
          {% assign error = true %}
        {% endif %}
        {% comment %} カートに入っているチケットのn日前を取得 {% endcomment %}

      {% if settings.minus_num != blank %}
        {% assign minus_num =  settings.minus_num | plus: 0  %}
      {% endif %}

      {% if settings.minus_num_tags != blank %}
        {% assign minus_num_tags = settings.minus_num_tags | split: "," %}
        {% for minus_num_tag in minus_num_tags %}
          {% assign minus_num_tag_split = minus_num_tag | split: "||" %}
          {% if item.product.tags contains minus_num_tag_split[0] %}
            {% assign minus_num = minus_num_tag_split[1] | plus: 0 %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if minus_num != blank  %}
        {% assign minus_day = minus_num %}
        {% assign minus_num = minus_num | times: 86400 %}
        {% assign ticket_date_minus = item.product.metafields.ticket.date | date: '%s' | minus: minus_num %}
      {% endif %}
        {% assign flug = true %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if ticket_date_minus != blank %}
    {% assign now = '' %}
    {% if shop.metafields.time.now %}
      {% assign now = shop.metafields.time.now | date: '%s' | plus: 0 %}
      {% if now >= ticket_date_minus %}
        {% assign disable_sale_days_ago = true %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endif %}
