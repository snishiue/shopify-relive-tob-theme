              <div class="lineitem-property-wrapper {{set_id[i]}}" style="display:none;">
                <label>{{lineitem_property_label[i]}}</label><br>
                <div class="select">  <select class="select__select {% if is_required[i] == 'true' %} required {% endif %}" id="{{lineitem_property_id[i]}}" name="{{lineitem_property_name[i]}}">
                    <option value="" hidden>選択してください</option>
                  {% if lineitem_property_select_value_1[i] != blank and lineitem_property_select_text_1[i] != blank %}
                    <option value="{{lineitem_property_select_value_1[i]}}">{{lineitem_property_select_text_1[i]}}</option>
                  {% endif %}
                  {% if lineitem_property_select_value_2[i] != blank and lineitem_property_select_text_2[i] != blank %}
                    <option value="{{lineitem_property_select_value_2[i]}}">{{lineitem_property_select_text_2[i]}}</option>
                  {% endif %}
                  {% if lineitem_property_select_value_3[i] != blank and lineitem_property_select_text_3[i] != blank %}
                    <option value="{{lineitem_property_select_value_3[i]}}">{{lineitem_property_select_text_3[i]}}</option>
                  {% endif %}
                  {% if lineitem_property_select_value_4[i] != blank and lineitem_property_select_text_4[i] != blank %}
                    <option value="{{lineitem_property_select_value_4[i]}}">{{lineitem_property_select_text_4[i]}}</option>
                  {% endif %}
                  {% if lineitem_property_select_value_5[i] != blank and lineitem_property_select_text_5[i] != blank %}
                    <option value="{{lineitem_property_select_value_5[i]}}">{{lineitem_property_select_text_5[i]}}</option>
                  {% endif %}
                  {% if lineitem_property_select_value_6[i] != blank and lineitem_property_select_text_6[i] != blank %}
                    <option value="{{lineitem_property_select_value_6[i]}}">{{lineitem_property_select_text_6[i]}}</option>
                  {% endif %}
                  {% if lineitem_property_select_value_7[i] != blank and lineitem_property_select_text_7[i] != blank %}
                    <option value="{{lineitem_property_select_value_7[i]}}">{{lineitem_property_select_text_7[i]}}</option>
                  {% endif %}
                  {% if lineitem_property_select_value_8[i] != blank and lineitem_property_select_text_8[i] != blank %}
                    <option value="{{lineitem_property_select_value_8[i]}}">{{lineitem_property_select_text_8[i]}}</option>
                  {% endif %}
                  {% if lineitem_property_select_value_9[i] != blank and lineitem_property_select_text_9[i] != blank %}
                    <option value="{{lineitem_property_select_value_9[i]}}">{{lineitem_property_select_text_9[i]}}</option>
                  {% endif %}
                  </select>
                {% render 'icon-caret' %}
                </div>
              </div>
            {% endif %}
          {% endfor %}

          {% if lineitem_property_memo_label != blank and lineitem_property_memo_id != blank and lineitem_property_memo_name != blank %}
            <p class="clineitem-property__field">
              <label style="display: block;" for="{{lineitem_property_memo_id}}">{{lineitem_property_memo_label}}</label>
              <textarea id="{{lineitem_property_memo_id}}" name="{{lineitem_property_memo_name}}" style="
                width: 100%;
                min-height: 10em;
                padding: .5em;
            "></textarea>
            </p>
          {% endif %}


          {%- if gift_card_recipient_feature_active -%}
            {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
          {%- endif -%}

          <div class="product-form__buttons">
            {%- liquid
              assign check_against_inventory = true
              if product.selected_or_first_available_variant.inventory_management != 'shopify' or  product.selected_or_first_available_variant.inventory_policy == 'continue'
                assign check_against_inventory = false
              endif
              if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                assign quantity_rule_soldout = true
              endif
            -%}
            <button
              id = "ProductSubmitButton-{{ section_id }}"
              type="submit"
              name="add"
              class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
              {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout%}
                disabled
              {% endif %}
            >
              <span>
                {%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                  {{ 'products.product.sold_out' | t }}
                {%- else -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- endif -%}
              </span>
              <div class="loading-overlay__spinner hidden">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  class="spinner"
                  viewBox="0 0 66 66"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                </svg>
              </div>
            </button>
            {%- if show_dynamic_checkout -%}
              {{ form | payment_button }}
            {%- endif -%}
          </div>
        {%- endform -%}
      </product-form>
    {% endif %}
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}
  {% endcapture %}



  {% comment %} 会員限定商品であればWrapperを表示しjsで判定 {% endcomment %}
  {% assign is_fc = false %}
  {% for artist_tag_valid in array_specialtags_app_member_only_artist %}
    {%- assign product_tags_join_valid = product.tags | join: ',' | downcase -%}
    {%- assign product_tags_split_valid = product_tags_join_valid | split: ',' -%}

    {%- assign artist_tag_downcase_valid = artist_tag_valid | downcase -%}
    {% if product.available and product_tags_split_valid contains artist_tag_downcase_valid %}
      {% assign is_fc = true %}
      {% break %}
    {% endif %}
  {% endfor %}


  {% if is_fc %}
    <div id="product__add-to-cart-wrapper" class="product__add-to-cart-wrapper product-form"></div>
  {% else %}
    {{product_add_to_cart }}
  {% endif %}

{%- comment -%}アプリ会員限定ボタンjs描画処理(リファラー版)start{%- endcomment -%}
{% if is_fc %}
  <script>
    let cartButtonWrapper__BuyButtons = document.getElementById('product__add-to-cart-wrapper');
    let ProductAddToCart__BuyButtons = '{{ product_add_to_cart | strip_newlines }}';
    let isFC__BuyButtons = false;
  </script>
  {% for artist_tag in array_specialtags_app_member_only_artist %}
    {%- assign product_tags_join = product.tags | join: ',' | downcase -%}
    {%- assign product_tags_split = product_tags_join | split: ',' -%}

    {%- assign artist_tag_downcase = artist_tag | downcase -%}
    {% if product.available and product_tags_split contains artist_tag_downcase %}
      <script>
        if(isFC__BuyButtons === false) {
          if (tgApp.isMemberReferrer(['{{ array_app_members_only_valid_text_artist[forloop.index0] }}'], 'referrerAppArtist{{request.host | handleize}}{{forloop.index0}}', 'referrerAppValidDateArtist{{request.host | handleize}}{{forloop.index0}}')) {
            // アプリ会員なら通常のボタンを表示
            cartButtonWrapper__BuyButtons.insertAdjacentHTML('afterbegin', ProductAddToCart__BuyButtons);
            isFC__BuyButtons = true
          }
        }
      </script>
    {% endif %}
  {% endfor %}

  <script>
    // アプリ会員でなければ購入無効のボタンを表示
    if (isFC__BuyButtons === false) {
      cartButtonWrapper__BuyButtons.insertAdjacentHTML('afterbegin',' <button class="product-form__submit button button--full-width button--primary" disabled>FC会員限定</button>');
    }
  </script>
{% endif %}
{%- comment -%}アプリ会員限定ボタンjs描画処理(リファラー版) end{%- endcomment -%}

  {% endunless %}

  {%- if show_pickup_availability -%}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
      | where: 'pick_up_enabled', true
    -%}

    <pickup-availability
      class="product__pickup-availabilities no-js-hidden quick-add-hidden"
      {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
        available
      {% endif %}
      data-root-url="{{ routes.root_url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-has-only-default-variant="{{ product.has_only_default_variant }}"
    >
      <template>
        <pickup-availability-preview class="pickup-availability-preview">
          {% render 'icon-unavailable' %}
          <div class="pickup-availability-info">
            <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
            <button class="pickup-availability-button link link--text underlined-link">
              {{ 'products.product.pickup_availability.refresh' | t }}
            </button>
          </div>
        </pickup-availability-preview>
      </template>
    </pickup-availability>

    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</div>

{%- style -%}
  .product-form__submit  {
    {%- if character['cart-button-color'].value != nil -%}
      --color-button: {{ character['cart-button-color'].value.red }}, {{ character['cart-button-color'].value.green }}, {{ character['cart-button-color'].value.blue }};
    {%- endif -%}
    {%- if character['cart-button-text-color'].value != nil -%}
      --color-button-text: {{ character['cart-button-text-color'].value.red }}, {{ character['cart-button-text-color'].value.green }}, {{ character['cart-button-text-color'].value.blue }};
    {%- endif -%}
  }
{%- endstyle -%}