{%- liquid
  comment
    販売停止タグ
  endcomment
  for tag in product.tags
    if tag contains '_disabled:'
      assign label = tag | split: ':'
      assign stop_tag_name = label[1]
    endif
  endfor
-%}



{% comment %}

{%- liquid
  assign group_key = '_group:'

  assign disabled_label = ''
  assign product_group_name = ''
  for tag in product.tags
    assign temp = tag | split: ':' | last
    if tag contains '_disabled:'
      assign disabled_label = temp
    endif

    if tag contains group_key
      assign product_group_name = temp
    endif
  endfor

  assign in_cart_product_groups = ''
  for item in cart.items
    for tag in item.product.tags
      if tag contains group_key
        if in_cart_product_groups != blank
          assign in_cart_product_groups = in_cart_product_groups | append: ','
        endif

        assign temp = tag | split: ':' | last
        assign in_cart_product_groups = in_cart_product_groups | append: temp
      endif
    endfor
  endfor

  assign is_multiple_group = false
  if in_cart_product_groups != blank and product_group_name != blank
    assign groups = in_cart_product_groups | split: ','
    for group in groups
      if group != product_group_name
        assign is_multiple_group = true
        break
      endif
    endfor
  endif
-%} {% endcomment %}

