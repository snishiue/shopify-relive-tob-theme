{% style %}
/* tag-color snippets */
.taglabel__item--thumnail {
  display: inline-block;
  border-radius: 2px;
  padding: 1px 4px;
  line-height: 14px;
  font-size: 8px;
}

.taglabel__item--detail {
  display: inline-block;
  border-radius: 2px;
  padding: 4px 12px;
  line-height: 16px;
  font-size: 12px;
}

.taglabel__color--thumnail {
  display: flex;
  flex-wrap: wrap;
  font-size: 1.4rem;
  padding: 5px 0 5px 0;
  min-height: 24px;
  gap: 4px 6px;
}
.taglabel__color--detail {
  display: flex;
  gap: 6px;
  margin: .5em 0;
}

@media screen and (max-width: 749px) {
  .taglabel__item--thumnail {
    padding: 3px 6px 3px 6px;
    margin: 1px;
  }
  .taglabel__color--thumnail {
    font-size: 11.5px;
    padding: 4px 0 4px 0;
  }
}

.taglabel__color.taglabel__color--empty {
  display: block;
  margin-top: 5px;
}

{% endstyle %}

{% comment %} 商品サムネ、商品詳細用にタグを出力するsnippets {% endcomment %}
{% assign tags_html = tags_html %}

{%- capture tags_html -%}
  {%- for tag in tags -%}
    {%- assign has_color = false -%}
    {%- unless tag contains '_' -%}
      {%- for item in shop.metaobjects.tagcolors.tagcolors.tagcolor.value -%}
        {%- assign name_splits = item.tag | split: ',' -%}
        {%- for name_split in name_splits -%}
          {%- if tag contains name_split -%}
            <div class="taglabel__color taglabel__color--normal font-jp {% if is_thumnail %}taglabel__item--thumnail {% else %} taglabel__item--detail {% endif %}"
              style="
              {%- if item.color != blank -%}
                background-color: {{item.color.value}};
              {%- endif -%}
              {%- if item.border_color != blank -%}
                border-color: {{item.border_color}};
              {%- endif -%}
              {%- if item.text_color != blank -%}
               color: {{item.text_color}};
              {%- endif -%}
              order: {{ forloop.index }};
              ">{{- tag -}}</div>
            {%- assign has_color = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
      {%- if has_color == false -%}
        <div class="taglabel__item taglabel__item--normal font-jp {% if is_thumnail %}taglabel__item--thumnail {% else %} taglabel__item--detail {% endif %}"
          style="
          {%- if shop.metaobjects.tagcolor.default.color != blank -%}
            background-color: {{shop.metaobjects.tagcolor.default.color}};
          {%- endif %}
          {%- if shop.metaobjects.tagcolor.default.border_color != blank -%}
            border-color: {{shop.metaobjects.tagcolor.default.border_color}};
          {%- endif %}
          {%- if shop.metaobjects.tagcolor.default.text_color != blank -%}
            color: {{shop.metaobjects.tagcolor.default.text_color}};
          {%- endif -%}
          ">{{- tag -}}
        </div>
      {%- endif -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{% if tags_html != blank and hidden_tag != true %}
  <div class="taglabel__color {% if is_thumnail %}taglabel__color--thumnail {% else %} taglabel__color--detail {% endif %}">
    {{ tags_html }}
  </div>
{% else %}
<div class="taglabel__color taglabel__color--empty"></div>
{% endif %}