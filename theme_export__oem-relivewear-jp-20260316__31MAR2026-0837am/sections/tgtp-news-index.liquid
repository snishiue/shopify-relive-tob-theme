{{ 'tgtp-news-index.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .main-article__item-wrapper {
    display: flex;
    gap: 3rem;
  }

  .main-article__content-info {
    display: grid;
    grid-template-rows: 1fr 1fr;
    align-items: center;
  }

{%- endstyle -%}

{% liquid
  assign image_height = section.settings.image_height
  if image_height == 'adapt'
    assign image_height = 
  elsif image_height == 'small'
    assign image_height = '66'
    assign image_width = '100'
  elsif image_height == 'medium'
    assign image_height = '133'
    assign image_width = '200'
  elsif image_height == 'large'
    assign image_height = '200'
    assign image_width = '300'
  endif
%}

{%- paginate blog.articles by article_count -%}
  <div class="tgtp-news-index main-blog page-width page-width--narrow section-{{ section.id }}-padding">
    <h1 class="center">
      {{ section.settings.title }}
    </h1>

    <div>
      <div class="main-article__list">
        {%- for article in blog.articles -%}
          {%- liquid
            assign is_show_image = false
            if section.settings.show_image and article.image != blank
              assign is_show_image = true
            endif
          -%}
          <a class="main-article__item" href="{{ article.url }}">
            <div class="main-article__item-wrapper">
            {%- if is_show_image -%}
              <div class="main-article__content-image">
                <img src="{{ article.image | image_url: width: image_width }}" alt="{{ article.title }}" width="{{ image_width }}" height="{{ image_height }}">
              </div>
            {%- endif -%}
              <div class="main-article__content-info">
                <div class="main-article__content-title">{{ article.title }}</div>
                <div class="main-article__content-date">{{ article.published_at | date: "%Y.%m.%d" }}</div>
                {%- if section.settings.show_author -%}
                  <div class="main-article__content-author">{{ article.author }}</div>
                {%- endif -%}
              </div>
            </div>
              {{- 'icon-caret-right.svg' | inline_asset_content -}}
          </a>
        {%- endfor -%}
      </div>
    </div>


    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% style %}
  :root {
    --article_content-title_font_color: {{ section.settings.article_content-title_font_color }};
    --article_date_font_color: {{ section.settings.article_date_font_color }};
    --article_border_color: {{ section.settings.article_border_color }};
    --article_title_alignment: {{ section.settings.title_alignment }};
    --article_padding_content_top: {{ section.settings.padding_content_top }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "TGTP news index",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header.content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "タイトル",
      "default": "お知らせ"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "タイトルの配置",
      "options": [
        {
          "value": "left",
          "label": "左寄せ"
        },
        {
          "value": "center",
          "label": "中央寄せ"
        },
        {
          "value": "right",
          "label": "右寄せ"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-blog.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.main-blog.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.main-blog.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.main-blog.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.main-blog.settings.image_height.label",
      "info": "t:sections.main-blog.settings.image_height.info"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-blog.settings.paragraph.content"
    },
    {
      "type": "header",
      "content": "表示数"
    },
    {
      "type": "range",
      "id": "article_count",
      "label": "表示数",
      "default": 10,
      "min": 6,
      "max": 50,
      "step": 1
    },
    {
      "type": "header",
      "content": "配色"
    },
    {
      "type": "color",
      "id": "article_content-title_font_color",
      "label": "記事タイトルの色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "article_date_font_color",
      "label": "記事日付の色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "article_border_color",
      "label": "記事の枠線の色",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_content_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "タイトル下の余白",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "TGTP news index"
    }
  ]
}
{% endschema %}
