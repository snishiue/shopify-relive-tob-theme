<script>
  // First Block
  function setRecentlyViewedPdp() {
    const pdpData = {
      productId: "{{ product.id }}",
      productTitle: "{{ product.title | escape }}",
      productPrice: "{{ product.price | money }}",
      productImg: "{{ product.featured_image | img_url: '1024x' }}",
      productImgRatio: {{ product.featured_image.aspect_ratio | default: 1 }},
      productUrl: "{{ product.url }}",
      available: {{ product.available | json }},
      tags: {{ product.tags | json }},
      isHiddenPriceUntilSelling: "{{ product.metafields.custom.hidden_price_until_selling }}",
      startDate: "{{ product.metafields.datetime.start }}"
    };

    // Check if productTitle is empty and return if true
    if (!pdpData.productTitle) {
      return;
    }

    // Init Empty Array to push data
    const productArr = [];
    let jsonResp, jsonRespArr, jsonRespArrStr;
    const numberOfProduct = {{ section.settings.display_quantity }}; //表示商品数の設定
    productArr.push(pdpData);
    const currPdpTitle = pdpData.productTitle;
    const pdpDataString = JSON.stringify(productArr);
    const localData = localStorage.getItem('recently_viewed');

    if (localData == null) {
      localStorage.setItem('recently_viewed', pdpDataString);
    } else if (localData != null) {
      const oldPdpData = localStorage.getItem('recently_viewed');
      const countPdpData = (oldPdpData.match(/productTitle/g) || []).length;
      const reVisitPdp = oldPdpData.includes(currPdpTitle);
      if (countPdpData < numberOfProduct && !reVisitPdp) {
        jsonResp = JSON.parse(oldPdpData);
        jsonRespArr = productArr.concat(jsonResp);
        jsonRespArrStr = JSON.stringify(jsonRespArr);
        localStorage.setItem('recently_viewed', jsonRespArrStr);
      } else if (countPdpData >= numberOfProduct && !reVisitPdp) {
        jsonResp = JSON.parse(oldPdpData);
        jsonResp.pop();
        jsonRespArr = productArr.concat(jsonResp);
        jsonRespArrStr = JSON.stringify(jsonRespArr);
        localStorage.setItem('recently_viewed', jsonRespArrStr);
      }
    }
  }

  setRecentlyViewedPdp();
</script>

<div class="tgtp-recently-products section-{{ section.id }}-padding">
  <div class="{% if section.settings.page_width %}page-width{% endif %}">
    {% render 'tgtp-section__heading' %}
  </div>

  <div class="tgtp-recently-products__slider">
    <div class="tgtp-recently-products__container product-grid-container scroll-trigger animate--slide-in {% if section.settings.page_width %}page-width{% endif %}"" data-cascade="">
      <div class="loading-overlay gradient"></div>
      <ul class="tgtp-recently-products__wrapper grid product-grid grid--{{ section.settings.row_quantity_mobile }}-col-tablet-down grid--{{ section.settings.row_quantity }}-col-desktop js-recentPdpBlock"></ul>
      <p class="no-recent-items" style="display: none;text-align:center;margin:40px 0">{{ 'sections.recently_checked.empty_text' | t }}</p>
    </div>
  </div>
</div>

{% style %}
  .tgtp-recently-products {
    --tgtp-row-quantity: {{ section.settings.row_quantity }};
    --tgtp-row-quantity-mobile: {{ section.settings.row_quantity_mobile }};

    --tgtp-grid-desktop-spacing: {{ section.settings.column_gap }}px;

    --tgtp-grid-mobile-spacing: {{ section.settings.column_gap_sp }}px;
  }
{% endstyle %}

{% style %}
  .tgtp-recently-products {
    --tgtp-width: 100vw;
    --tgtp-base-width: 100vw;
    --tgtp-negative-bias: 2vw;
    --tgtp-margin: 50px;
  }
  @media screen and (min-width: 1200px) {
    .tgtp-recently-products {
      --tgtp-width: 1100px;
      --tgtp-base-width: 1100px;
      --tgtp-negative-bias: 2%;
      --tgtp-margin: (100vw - 1100px) / 2;
    }
  }
  @media screen and (min-width: 750px and max-width: 1199px) {
    .tgtp-recently-products {
      --tgtp-base-width: calc(100vw - 100px);
    }
  }
  @media screen and (max-width: 749px) {
    .tgtp-recently-products {
      --tgtp-margin: 10px;
    }
  }
{% endstyle %}

<script>
  // Third Block
  function getRecentPdp() {
    const pdpData = JSON.parse(localStorage.getItem('recently_viewed'));
    if (!pdpData || pdpData.length === 0) {
      document.querySelector('.no-recent-items').style.display = 'block';
      return;
    }

    // section.settings の値を取得
    const rowQuantity = {{ section.settings.row_quantity }};
    const rowQuantityMobile = {{ section.settings.row_quantity_mobile }};

    // スタイル要素を取得または作成
    let styleElement = document.getElementById('dynamic-style');
    if (!styleElement) {
      styleElement = document.createElement('style');
      styleElement.id = 'dynamic-style';
      document.head.appendChild(styleElement);
    }

    let newStyles = `
      .tgtp-recently-products {
        --tgtp-width: 100vw;
        --tgtp-base-width: 100vw;
        --tgtp-negative-bias: 2vw;
        --tgtp-margin: 50px;
      }
      @media screen and (min-width: 1200px) {
        .tgtp-recently-products {
          --tgtp-width: 1100px;
          --tgtp-base-width: 1100px;
          --tgtp-negative-bias: 2%;
          --tgtp-margin: (100vw - 1100px) / 2;
        }
      }
      @media screen and (min-width: 750px and max-width: 1199px) {
        .tgtp-recently-products {
          --tgtp-base-width: calc(100vw - 100px);
        }
      }
      @media screen and (max-width: 749px) {
        .tgtp-recently-products {
          --tgtp-margin: 10px;
        }
      }
    `;

    // 条件に応じて --tgtp-margin を 0 に変更
    if (pdpData.length < rowQuantity) {
      newStyles += `
        .tgtp-recently-products {
          --tgtp-margin: 0px !important;
        }
      `;
    } else if (window.innerWidth <= 749 && pdpData.length < rowQuantityMobile) {
      newStyles += `
        @media screen and (max-width: 749px) {
          .tgtp-recently-products {
            --tgtp-margin: 0px !important;
          }
        }
      `;
    }

    // スタイルを更新
    styleElement.innerHTML = newStyles;

    // アイテム数を CSS 変数 --tgtp-display-quantity に設定
    document.documentElement.style.setProperty('--tgtp-display-quantity', pdpData.length);

    const recentViewHtml = [];
    pdpData.forEach(function (item) {
      if (!item) return;

      const isDisabled = item.tags.some((tag) => tag.includes('_disabled:'));
      const isAvailable = (item.available && !isDisabled) ?? false;
      const isComingSoon = item.tags && item.tags.includes('comingsoon');
      const ratioPercent = item.productImgRatio ? (100 / item.productImgRatio).toFixed(2) : 100;

      const shouldDisplayPrice = item.isHiddenPriceUntilSelling !== "true";
      const startDate = item.startDate ? new Date(item.startDate) : null;
      const currentDate = new Date();
      const isDisplayPrice = (startDate === null || startDate <= currentDate || shouldDisplayPrice);
      recentViewHtml.push(`
        <li class="grid__item scroll-trigger animate--slide-in" data-cascade="" style="--animation-order: 0;">
          <div class="card-wrapper product-card-wrapper underline-links-hover">
            <div class="card card--standard card--media">
              <div class="card__inner color-background-2 gradient ratio" style="--ratio-percent: ${ratioPercent}%;">
                <div class="card__media">
                  <div class="media media--transparent media--hover-effect">
                    <img srcset="${item.productImg}" src="${item.productImg}" sizes="(min-width: 1400px) 317px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)" alt="${item.productTitle}" class="motion-reduce" width="1178" height="1578">
                  </div>
                </div>
                <div class="card__content">
                  <div class="card__information">
                    <h3 class="card__heading">
                      <a href="${item.productUrl}" id="StandardCardNoMediaLink-{{ section.id }}" class="full-unstyled-link" aria-labelledby="StandardCardNoMediaLink-{{ section.id }} NoMediaStandardBadge-{{ section.id }}">
                        ${item.productTitle}
                      </a>
                    </h3>
                  </div>
                </div>
                ${!isAvailable ? `
                  <div class="card__image-overlay">
                    <div class='card__image-overlay-text'>SOLD OUT</div>
                  </div>
                ` : ''}
                ${isComingSoon ? `
                  <div class="card__image-overlay">
                    <div class='card__image-overlay-text'>COMING SOON</div>
                  </div>
                ` : ''}
              </div>
              <div class="card__content">
                <div class="card__information">
                  <h3 class="card__heading h5" id="title-{{ section.id }}">
                    <a href="${item.productUrl}" id="CardLink-{{ section.id }}" class="full-unstyled-link" aria-labelledby="CardLink-{{ section.id }} Badge-{{ section.id }}">
                      <span>
                        ${item.productTitle}
                      </span>
                    </a>
                  </h3>
                  ${isDisplayPrice ? `
                    <div class="card-information">
                      <div class="price">
                        <div class="price__container" style="padding-bottom:.4em;">
                          <div class="price__regular">
                            <span class="price-item price-item--regular">${item.productPrice}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  ` : ''}
                </div>
              </div>
            </div>
          </div>
        </li>
      `);
    });

    const recentBlock = `${recentViewHtml.join('')}`;
    const contentBlock = document.querySelectorAll('.js-recentPdpBlock');
    contentBlock.forEach(element => {
      element.innerHTML = recentBlock;
    });
  }

  document.addEventListener('DOMContentLoaded', getRecentPdp);
  window.addEventListener('resize', getRecentPdp);
</script>


