{% comment %} 時間制御 {% endcomment %}
{% comment %} メタフィールドがある場合に比較 {% endcomment %}
{% assign before_sale = false %}
{% assign disable_sale = false %}
{% if shop.metafields.time.now %}
  {% for cart_item in cart.items %}
    {% comment %} 開始日時 {% endcomment %}
    {% if cart_item.product.metafields.datetime.start %}
      {% assign timenow = shop.metafields.time.now | date: '%s' %}
      {% assign producttime_start = product.metafields.datetime.start | date: '%s' %}
      {% if timenow < producttime_start %}
        {% assign before_sale = true %}
      {% endif %}
    {% endif %}
    {% comment %} 終了日時 {% endcomment %}
    {% if cart_item.product.metafields.datetime.end %}
      {% assign timenow = shop.metafields.time.now | date: '%s' %}
      {% assign producttime = cart_item.product.metafields.datetime.end | date: '%s' %}
      {% if timenow >= producttime %}
        {% assign disable_sale = true %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}


{% comment %} 購入数制限 {% endcomment %}
{% liquid
  assign exceed_quantity = false
  assign short_quantity = false
  assign stop_sale = false

  for cart_item in cart.items
    assign max_product_quantity = cart_item.product.metafields.purchase_limit.quantity
    assign max_variant_quantity = cart_item.product.metafields.variant_purchase_limit.quantity

    comment
    【特殊要件】カートに入っている受付枠のバリエーションに応じて商品側の個数制御
    endcomment

    assign is_ticket = false
    assign is_ticket_prod = false
    for tag in cart_item.product.tags
      if tag == '_会場引換:受付枠'
        assign is_ticket = true
      endif
      if tag contains '_会場引換:商品'
        assign is_ticket_prod = true
      endif
    endfor
    assign min_quantity = 0
      unless cart_item.product.metafields.purchase_limit.quantity
        if is_ticket_prod
          for item in cart.items
            for tag in item.product.tags
            if tag == '_会場引換:受付枠'
              for option in item.variant.options
                  if option contains 'ペア席'
                    assign max_product_quantity = 2
                    break
                  elsif option contains 'テーブル席'
                    assign max_product_quantity = 4
                    assign min_quantity = 3
                    break
                  endif
                endfor
            endif
            endfor
          endfor
        endif
      endunless

      if is_ticket
        assign max_product_quantity = 1
      endif


    if min_quantity > 0
      assign current_product_quantity_in_cart = 0
      for cart_item2 in cart.items
        if cart_item.product.id == cart_item2.product.id
          assign current_product_quantity_in_cart = current_product_quantity_in_cart | plus: cart_item2.quantity
        endif
      endfor

      if current_product_quantity_in_cart < min_quantity
        assign short_quantity = true
      endif
    endif
    comment
    【特殊要件終わり】
    endcomment

    if max_product_quantity
      assign current_product_quantity_in_cart = 0
      for cart_item2 in cart.items
        if cart_item.product.id == cart_item2.product.id
          assign current_product_quantity_in_cart = current_product_quantity_in_cart | plus: cart_item2.quantity
        endif
      endfor

      if current_product_quantity_in_cart > max_product_quantity
        assign exceed_quantity = true
      endif
    endif

    if max_variant_quantity
      if max_variant_quantity < cart_item.quantity
        assign exceed_quantity = true
      endif
    endif

    if customer
      for tag in cart_item.product.tags
        if tag contains '_limit:'
          if customer.tags contains tag
            assign cant_purchase_twice = true
          endif
        endif
      endfor
    endif

    comment 
    variantごとのユーザ単位購入制限
    variant_idで購入有無を判断
    variantは一意なので、一回購入時にflowでid名でタグ付け。買えなくなる形（limit-variant）
    endcomment
    if customer
      for tag in customer.tags
        if tag contains '_limit-variant:'
          if tag contains cart_item.variant_id
            assign cant_purchase_twice = true
          endif
        endif
      endfor
    endif


    for tag in cart_item.product.tags
      if tag contains '_disable:'
        assign stop_sale = true
      endif
    endfor
  endfor
%}


{% comment %} 買い合わせ制限スクリプト（購入に進むボタン版） {% endcomment %}
{%- liquid
  comment
    現在、カートに入っている商品の全てのpurchase_groupを取り出し
  endcomment

  assign cart_item_purchase_groups = ''
  for item in cart.items
    for tag in item.product.tags
      if tag contains '_group:'
        assign label = tag | split: ':'
        assign cart_item_purchase_groups = cart_item_purchase_groups | append: label[1] | append: ','
      endif
    endfor
  endfor
  assign cart_item_purchase_groups = cart_item_purchase_groups | split: ','
-%}
{%-liquid
  assign num_combination = cart_item_purchase_groups | uniq | size

  assign bad_combination = false
  if num_combination > 1
    assign bad_combination = true
  endif
-%}



{% comment %} 買い合わせ制限スクリプト（購入に進むボタン版）（通常商品買い合わせNG版） {% endcomment %}
{%- liquid

  comment
    現在、カートに入っている商品の全てのpurchase_groupを取り出し
  endcomment
  assign is_group_tag_product_empty = false
  assign is_group_tag_product = false
  assign cart_item_purchase_groups_checkout = ''
  for item in cart.items
    for tag in item.product.tags
      if tag contains '_ng_with_normal_group:'
        assign label_checkout = tag | split: ':'
        assign cart_item_purchase_groups_checkout = cart_item_purchase_groups_checkout | append: label_checkout[1] | append: ','
      endif
      if tag contains '_group:'
        assign is_group_tag_product = true
      endif
    endfor
    if is_group_tag_product == false
      assign is_group_tag_product_empty = true
    endif
      assign is_group_tag_product = false
  endfor

  assign cart_item_purchase_groups_checkout = cart_item_purchase_groups_checkout | split: ','
-%}


{%-liquid
  assign combination_checkout = cart_item_purchase_groups_checkout | uniq


  assign bad_combination_checkout_with_normal_group = false
  if is_group_tag_product_empty == true and combination_checkout != blank and cart.items != blank
    assign bad_combination_checkout_with_normal_group = true
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.sp_padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.sp_padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="cart__footer isolate section-{{ section.id }}-padding">
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      <div class="cart__blocks" style="margin: auto;">
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'subtotal' -%}
              <div class="js-contents" {{ block.shopify_attributes }} style="margin: 0 0 40px; border-top: 1px solid #E0E0E0; border-bottom: 1px solid #E0E0E0;">
                <div>
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      {%- for discount in cart.cart_level_discount_applications -%}
                        <li class="discounts__discount discounts__discount--position">
                          {{- 'icon-discount.svg' | inline_asset_content -}}
                          {{ discount.title | escape }}
                          (-{{ discount.total_allocated_amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="totals">
                  <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}<a style="font-size: 8px; color: #9E9E9E;">{{ 'sections.cart.tax_included' | t }}</a></h2>
                  <p class="totals__total-value">{{ cart.total_price | money_with_currency }}</p>
                </div>

                <small class="tax-note caption-large rte" style="font-size: 12px;">
                  {{ 'sections.cart.tgtp_shipping_note' | t }}
                  {% comment %}
                  {%- if cart.duties_included and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- endif -%}
                  {% endcomment %}
                </small>
              </div>
            {%- else -%}
            <div class="cart-footer-buttons">
              {%- if exceed_quantity or short_quantity or bad_combination or bad_combination_checkout_with_normal_group or before_sale or disable_sale or disable_sale_6days_ago or stop_sale or is_invalid_pickup_order or cant_purchase_twice or is_purchase == false -%}
                <div class="cart__ctas">
                  <div class="tgtp-cart__ctas--inner">
                    <button class="cart__checkout-button button" disabled>
                      ご購入手続きに進めません
                    </button>
                    
                    {% if is_purchase == false %}
                    {% elsif disable_sale_6days_ago %}
                    <div class="Cart__Validation Error">※購入不可の商品が含まれています</div>
                    {% elsif disable_sale or before_sale %}
                      <div class="Cart__Validation Error">※販売期間外の商品があります</div>
                    {% elsif stop_sale %}
                      <div class="Cart__Validation Error">※購入不可の商品が含まれています</div>
                    {% elsif cant_purchase_twice %}
                    {% elsif short_quantity %}
                      <div class="Cart__Validation Error">※購入可能点数に満たない商品があります</div>
                    {% elsif exceed_quantity %}
                      <div class="Cart__Validation Error">※購入可能点数を超えている商品があります</div>
                    {% elsif bad_combination or bad_combination_checkout_with_normal_group %}
                      <div class="Cart__Validation Error">※同時購入できない商品がカートにあります。</div>
                    {% elsif pickup_ticket_count > 1 or pickup_ticket_count_ok_only > 1%}
                      <div class="Cart__Validation Error">※予約日時が複数選択されています。</div>
                    {% elsif pickup_ticket_count == 0 and pickup_ticket_count_ok_only == 0 %}
                      <div class="Cart__Validation Error">※予約日時が選択されていません。</div>
                    {% elsif pickup_items_count == 0 %}
                      <div class="Cart__Validation Error">※座席数の選択をしてください。</div>
                    {% endif %}
                    <style>
                      .Cart__Validation.Error {
                        color: #eb001b;
                        font-size: .8em;
                        margin-top: .5em;
                      }
                    </style>
                    {% if is_ticket or is_ticket_prod %}
                      <button class="MainButton"
                        onclick="allCartRemoveAndBacktoTop(event, '/')"
                        style="
                        color: currentColor;
                        background: #5e5e5e;
                        color: white;
                        text-decoration: none;
                        border: 1px solid #7d7d7d;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        padding: 1.3em 1em;
                        font-size: .8em;
                        border-radius: 7px;
                        cursor: pointer;
                        max-width: 36rem;
                        margin: 1em auto 0;
                    "
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="icon icon-remove" style="
                          width: 1.4em;
                          height: 1.4em;
                          margin-right: 0.6em;
                          vertical-align: middle;
                      ">
                        <path d="M14 3h-3.53a3.07 3.07 0 00-.6-1.65C9.44.82 8.8.5 8 .5s-1.44.32-1.87.85A3.06 3.06 0 005.53 3H2a.5.5 0 000 1h1.25v10c0 .28.22.5.5.5h8.5a.5.5 0 00.5-.5V4H14a.5.5 0 000-1zM6.91 1.98c.23-.29.58-.48 1.09-.48s.85.19 1.09.48c.2.24.3.6.36 1.02h-2.9c.05-.42.17-.78.36-1.02zm4.84 11.52h-7.5V4h7.5v9.5z" fill="currentColor"></path>
                        <path d="M6.55 5.25a.5.5 0 00-.5.5v6a.5.5 0 001 0v-6a.5.5 0 00-.5-.5zM9.45 5.25a.5.5 0 00-.5.5v6a.5.5 0 001 0v-6a.5.5 0 00-.5-.5z" fill="currentColor"></path>
                      </svg>
                        カートを空にしてトップに戻る</a>
                    {% endif %}
                  </div>
                </div>
              {% else %}
                <div class="cart__pharmaceutical-agreement">
                  <label class="cart__pharmaceutical-agreement-label">
                    <input
                      type="checkbox"
                      id="pharmaceutical-agreement"
                      class="cart__pharmaceutical-agreement-checkbox"
                    >
                    <span>
                      <a href="https://cdn.shopify.com/s/files/1/0780/7565/8462/files/PDF.pdf?v=1772684720" target="_blank" rel="noopener noreferrer" class="cart__pharmaceutical-agreement-link">
                        {{ 'sections.cart.pharmaceutical_agreement_link' | t }}
                      </a>
                      {{ 'sections.cart.pharmaceutical_agreement_text' | t }}
                    </span>
                  </label>
                </div>
                <div class="cart__ctas" {{ block.shopify_attributes }}>
                  <button
                    type="submit"
                    id="checkout"
                    class="cart__checkout-button button"
                    name="checkout"
                    disabled
                    form="cart"
                  >
                    {{ 'sections.cart.checkout' | t }}
                  </button>
                </div>
                <script>
                  (function() {
                    var checkbox = document.getElementById('pharmaceutical-agreement');
                    var checkoutBtn = document.getElementById('checkout');
                    if (checkbox && checkoutBtn) {
                      checkbox.addEventListener('change', function() {
                        checkoutBtn.disabled = !this.checked;
                      });
                    }
                  })();
                </script>
              {% endif %}

              <div class="cart__ctas">
                <a href="{{ collections['all-items'].url }}" class="tgtp-button underlined-link" style="width: 100%; background-color: #fff; color: #212121;">
                  {{- 'general.continue_shopping' | t -}}
                </a>
              </div>

              {%- if additional_checkout_buttons -%}
                <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
            </div>
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TGTP Cart Footer",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "sp_padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "スマホ用 上部の余白",
      "default": 40
    },
    {
      "type": "range",
      "id": "sp_padding_bottom",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "スマホ用 下部の余白",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "TGTP Cart Footer"
    }
  ]
}
{% endschema %}
