{{ 'tgtp-customer.css' | asset_url | stylesheet_tag }}
{{ 'customer-fields.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  :root {
    --button-radius: {{ section.settings.button_radius }}px;
  }

{%- endstyle -%}

<div class="customer register section-{{ section.id }}-padding">
  <h2 class="center">
    {{ 'customer.register.title' | t }}
  </h2>
  {%- form 'create_customer' -%}
    {%- if form.errors -%}
      <div class="errors">
        {%- for field in form.errors -%}
          {%- if field == 'form' -%}
            <p class="error">{{ form.errors.messages[field] }}</p>
          {%- else -%}
            <a href="#RegisterForm-{{ field }}">
              {{ form.errors.translated_fields[field] | capitalize }}
              {{ form.errors.messages[field] }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="tgtp-field-container">
      <label for="RegisterForm-Company">
        {{ 'customer.register.company' | t }}
      </label>
      <span class="required">
        {{ 'customer.login_page.required' | t }}
      </span>
      <div class="tgtp-field">
        <input
          type="text"
          name="customer[note][company_name]"
          id="RegisterForm-Company"
          autocomplete="organization"
          placeholder="{{ 'customer.register.company' | t }}"
          required
        >
      </div>
    </div>
    <div class="tgtp-field-container">
      <label for="RegisterForm-LastName">
        {{ 'customer.register.last_name' | t }}
      </label>
      <span class="required">
        {{ 'customer.login_page.required' | t }}
      </span>
      <div class="tgtp-field">
        <input
        type="text"
        name="customer[last_name]"
        id="RegisterForm-LastName"
        {% if form.last_name %}
          value="{{ form.last_name }}"
        {% endif %}
        autocomplete="family-name"
        placeholder="{{ 'customer.register.last_name' | t }}"
        required
      >
      </div>
    </div>
    <div class="tgtp-field-container">
      <label for="RegisterForm-FirstName">
        {{ 'customer.register.first_name' | t }}
      </label>
      <span class="required">
        {{ 'customer.login_page.required' | t }}
      </span>
      <div class="tgtp-field">
        <input
        type="text"
        name="customer[first_name]"
        id="RegisterForm-FirstName"
        {% if form.first_name %}
          value="{{ form.first_name }}"
        {% endif %}
        autocomplete="given-name"
        placeholder="{{ 'customer.register.first_name' | t }}"
        required
      >
      </div>
    </div>
    <div class="tgtp-field-container">
      <label for="CustomerEmail" class="order">
        {{ 'customer.register.email' | t }}
      </label>
      <span class="required">
        {{ 'customer.login_page.required' | t }}
      </span>
      <div class="tgtp-field">
        <input
          type="email"
          name="customer[email]"
          id="CustomerEmail"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          {% if form.errors contains 'form' %}
            aria-invalid="true"
          {% endif %}
          placeholder="{{ 'customer.register.email' | t }}"
          required
        >
      </div>
    </div>
    {%- if form.errors contains 'email' -%}
      <span id="RegisterForm-email-error" class="form__message">
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <p class="error">{{ form.errors.translated_fields.email | capitalize }}</p>
        {{ form.errors.messages.email }}.
      </span>
    {%- endif -%}
    <div class="tgtp-field-container">
      <label for="CustomerPassword" class="order">
        {{ 'customer.register.password' | t }}
        <span class="required">
          {{ 'customer.login_page.required' | t }}
        </span>
      </label>
      <div class="tgtp-field">
        <input
          type="password"
          value=""
          name="customer[password]"
          id="CustomerPassword"
          autocomplete="new-password"
          {% if form.errors contains 'form' %}
            aria-invalid="true"
          {% endif %}
          placeholder="{{ 'customer.register.password' | t }}"
          required
        >
      </div>
    </div>
    {%- if form.errors contains 'password' -%}
      <span id="RegisterForm-password-error" class="form__message">
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        {{ form.errors.translated_fields.password | capitalize }}
        {{ form.errors.messages.password }}.
      </span>
    {%- endif -%}
    <button type="submit" style="border-radius: var(--button-radius); width: 100%;">
      {{ 'customer.register.submit' | t }}
    </button>
  {%- endform -%}
  <div class="center" style="margin: 5rem 0;">
    <p class="center login-label">
      {{ 'customer.register.already_have_account' | t }}
    </p>
    <div class="center">
      <a href="{{ routes.account_login_url }}" class="tgtp-button" style="width: 100%;">
        {{ 'customer.log_in' | t }}
      </a>
    </div>
  </div>
</div>

<script>
</script>

{% schema %}
{
  "name": "TGTP Register",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "px",
      "label": "Button Radius",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "TGTP Register"
    }
  ]
}
{% endschema %}
