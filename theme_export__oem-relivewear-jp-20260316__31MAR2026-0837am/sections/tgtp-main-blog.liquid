            "label": "通常",
            "value": "normal"
          },
          {
            "label": "蛍光ペン",
            "value": "highlight"
          },
          {
            "label": "ボーダー(中央)",
            "value": "border_center"
          },
          {
            "label": "ボーダー(見出し下)",
            "value": "border_bottom"
          },
          {
            "label": "ボーダー(左)",
            "value": "border_left"
          }
        ],
        "default": "normal"
      },
      {
        "type": "color",
        "id": "heading_color_text",
        "label": "見出し文字色",
        "default": "#222222"
      },
      {
        "type": "color",
        "id": "heading_color_sub1",
        "label": "見出しサブ色",
        "default": "#fff100"
      },
      {
        "type": "color",
        "id": "heading_color_sub2",
