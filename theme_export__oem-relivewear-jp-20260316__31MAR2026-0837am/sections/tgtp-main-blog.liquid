        "label": "見出しサブ色(グラデーション)",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "color",
        "id": "heading_color_textshadow",
        "label": "見出しテキストシャドウ",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "image_picker",
        "id": "heading_image",
        "label": "見出しアイコン"
      },
      {
        "type": "range",
        "id": "image_picker_size",
        "label": "見出しアイコン width",
        "min": 0,
        "max": 200,
        "step": 2,
        "default": 38,
        "unit": "px"
      },
      {
        "type": "image_picker",
        "id": "heading_alternateimage",
        "label": "見出し差し替え画像"
      },
      {
        "type": "range",
        "id": "heading_alternateimage_size",
        "label": "見出し差し替え画像 maxwidth",
        "min": 50,
        "max": 500,
        "step": 10,
        "default": 200,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "heading_alternateimage_size_mobile",
        "label": "見出し差し替え画像 maxwidth（モバイル）",
        "min": 50,
        "max": 500,
        "step": 10,
        "default": 200,
        "unit": "px"
      },
      {
        "type": "color",
        "id": "subheading_color",
        "label": "Subheading 文字色",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "range",
        "id": "title_lower_margin",
        "label": "タイトル下部 間隔",
        "min": 8,
        "max": 80,
        "step": 4,
        "default": 80,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "title_lower_margin_sp",
        "label": "タイトル下部 間隔 スマホ",
        "min": 8,
        "max": 80,
        "step": 4,
        "default": 80,
        "unit": "px"
      },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.featured-blog.settings.blog.label"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured-blog.settings.post_limit.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
