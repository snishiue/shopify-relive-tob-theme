{{ 'article.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign posts_displayed = section.settings.blog.articles_count
  if section.settings.post_limit <= section.settings.blog.articles_count or section.settings.post_limit <= 4
    assign posts_exceed_limit = true
    assign posts_displayed = section.settings.post_limit
  endif
-%}

<div class="blog color-{{ section.settings.color_scheme }} gradient{% if section.settings.heading == blank %} no-heading{% endif %}">
  <div class="article page-width-desktop isolate{% if posts_displayed < 3 %} page-width-tablet{% endif %} section-{{ section.id }}-padding">
    {% render 'tgtp-section__heading' %}

    <div class="page-width">
      {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
        <div class="article__list">
          <a href="{{ article.url }}">
            <div class="article__item">
              <div class="article__date">{{ article.published_at | date: "%Y.%m.%d" }}</div>
              <div class="article__content-title">
                {{ article.title }}
              </div>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>


    {%- if section.settings.show_view_all and section.settings.post_limit < section.settings.blog.articles_count -%}
      <div
        class="page-width article__view-all flexible-button medium-hide{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        <a
          href="{{ section.settings.blog.url }}"
          id="ViewAll-{{ section.id }}"
          class="article__view-all-button button"
          aria-labelledby="ViewAll-{{ section.id }} SectionHeading-{{ section.id }}"
        >
        {% if section.settings.view_all_text != blank %}
          {{ section.settings.view_all_text }}
        {% else %}
          {{ 'sections.featured_blog.view_all' | t }}
        {% endif %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    --article_border_color: {{ section.settings.article_border_color }};
    --article_section_background_color: {{ section.settings.article_section_background_color }};
    --article_background_color: {{ section.settings.article_background_color }};
    --article_border_radius: {{ section.settings.article_border_radius }}px;
    --article_date_font_color: {{ section.settings.article_date_font_color }};
    --article_content-title_font_color: {{ section.settings.article_content-title_font_color }};
    --article_top_margin: {{ section.settings.article_top_margin }}px;
    --article_view_all_text_color: {{ section.settings.article_view_all_text_color }};
    --article_view_all_background_color: {{ section.settings.article_view_all_background_color }};
    --flexible-button_align: {{ section.settings.flexible_button_align }};
    --flexible-button_sp_align: {{ section.settings.flexible_button_sp_align }};
    --article_view_all_border_radius: {{ section.settings.article_view_all_border_radius }}px;
  }
  .section-{{ section.id }}-padding .button:after {
    box-shadow: 0 0 0 calc(var(--buttons-border-width) + var(--border-offset))
      rgba(var(--color-button-text), var(--border-opacity)),
    0 0 0 var(--buttons-border-width) {{section.settings.article_view_all_border_color}};
    border-radius: {{ section.settings.article_view_all_border_radius }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "TGTP main blog",
  "tag": "section",
  "disabled_on": {
