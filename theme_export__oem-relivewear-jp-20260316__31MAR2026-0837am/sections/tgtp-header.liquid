  </div>
  {%- if section.settings.pin_cart_enable -%}
    <div class="pin-cart">
      <a a href="{{ routes.cart_url }}" class="icon cart__link" id="cart-icon-bubble-pin">
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.pin_cart_icon != blank -%}
          <img
            src="{{ section.settings.pin_cart_icon | image_url: 'master' }}"
            srcset="{{ section.settings.pin_cart_icon | image_url: width: section.settings.pin_cart_icon.width }} 1x, {{ section.settings.pin_cart_icon | image_url: width: section.settings.pin_cart_icon.width }} 2x"
            width="{{ section.settings.pin_cart_icon.width }}"
            height="{{ section.settings.pin_cart_icon.height }}"
            alt="{{ section.settings.pin_cart_icon.alt | default: shop.name | escape }}"
            class="pin-cart__img"
