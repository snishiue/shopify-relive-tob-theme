<div class="sidebar-wrapper">
  {% render 'tgtp-header-sidebar', section: section %}
</div>

<style>
  .header-wrapper {
    --header-height: {{ section.settings.header_height }}px;
    --header-margin-top: {{ section.settings.header_margin_top }}px;
    height: calc(var(--header-height) + var(--header-margin-top));
  }
  header {
    height: calc(var(--header-height) + var(--header-margin-top));
    background-color: {{ section.settings.header_bg_color }};
    color: {{ section.settings.header_txt_color }};
    fill: {{ section.settings.header_txt_color }};
    box-shadow: 0px 0px 7px 1px #19191978;
  }
  .header__inner {
    height: var(--header-height);
    margin-top: var(--header-margin-top);
  }
  header svg, header svg path {
    fill: {{ section.settings.header_txt_color }};
  }
  .search-form {
    height: var(--header-height);
  }

  .pin-cart {
    background-color: {{ section.settings.pin_cart_bg_color }};
  }

  .pin-cart svg {
    fill: {{ section.settings.pin_cart_icon_color }};
  }

  @media screen and (max-width: 749px) {
    .header-wrapper {
      --header-height: {{ section.settings.mobile_header_height }}px;
      --header-margin-top: 0px;
    }
  }

  .logo-img {
    height: 100%;
    max-height: 64px;
  }

  {%- if section.settings.logo_image != blank -%}
    .logo-img {
      width: {{ section.settings.logo_max_width }}px;
      height: auto;
      max-height: {{ section.settings.mobile_header_height }}px;
    }

    @media screen and (max-width: 749px) {
      .logo-img {
        width: {{ section.settings.mobile_logo_max_width }}px;
        height: auto;
      }
    }
  {%- endif -%}

  .cart-count-bubble {
    color: {{ section.settings.cart_bubble_txt_color }};
    background-color: {{ section.settings.cart_bubble_bg_color }};
  }

  .nav-item a.link, .nav-item span.link {
    color: {{ section.settings.header_txt_color }};
    font-size: 1.4rem;
  }

  .mega-menu {
    color: {{ section.settings.mega_menu_text }};
    background-color: {{ section.settings.mega_menu_bg }};
  }

  .mega-menu a, .mega-menu span {
    color: {{ section.settings.mega_menu_text }}!important;
  }

  a.mega-menu__link.link:before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    position: absolute;
    top: 0;
    left: -18px;
    bottom: 0;
    margin: auto 0;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: rotate(45deg);
  }
  .search-btn:hover {
    opacity: 0.8;
  }
</style>

