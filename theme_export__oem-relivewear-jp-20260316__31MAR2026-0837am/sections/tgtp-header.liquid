<link rel="stylesheet" href="{{ 'tgtp-header.css' | asset_url }}">
<script src="{{ 'tgtp-header.js' | asset_url }}" defer="defer"></script>

<div class="header-wrapper">
<header>
  <div class="header__inner">
    <div class="header-contents--PC">
      <div class="logo logo--PC">
        <a href="{{ routes.root_url }}" class="logo__link">
          {%- if section.settings.logo_image != blank -%}
            <img
              src="{{ section.settings.logo_image | image_url: 'master' }}"
              srcset="{{ section.settings.logo_image | image_url: width: section.settings.logo_image.width }} 1x, {{ section.settings.logo_image | image_url: width: section.settings.logo_image.width }} 2x"
              width="{{ section.settings.logo_image.width }}"
              height="{{ section.settings.logo_image.height }}"
              alt="{{ section.settings.logo_image.alt | default: shop.name | escape }}"
              class="logo-img"
            >
          {%- else -%}
            <img
              src="{{ 'relive_logo_2_200x@2x.png' | asset_url }}"
              alt="{{ shop.name | escape }}"
              class="logo-img"
            >
          {%- endif -%}
        </a>
      </div>
      <div class="nav-bar">
        <div class="nav-bar__inner">
          {%- assign menu_handle = section.settings.menu | default: 'main-menu' -%}
          {%- assign nav_menu = linklists[menu_handle] -%}
          {%- for link in nav_menu.links -%}
            <div class="nav-item">
              {%- if link.links.size == 0 and link.url != '/' -%}
                <a href="{{ link.url }}" class="nav-bar__link link" data-type="menuitem">{{ link.title }}</a>
              {%- else -%}
                {%- capture index -%}desktop-menu-0-{{ forloop.index }}{%- endcapture -%}
                {%- if link.links == blank -%}
                  <a href="{{ link.url }}" class="nav-bar__link link" data-type="menuitem" aria-expanded="false" aria-controls="{{ index }}" aria-haspopup="true">
                {%- else -%}
                  <span href="{{ link.url }}" class="nav-bar__link link" data-type="menuitem" aria-expanded="false" aria-controls="{{ index }}" aria-haspopup="true">
                {%- endif -%}
                  {{- link.title -}}
                {%- if link.links == blank -%}
                  </a>
                {%- else -%}
                  </span>
                {%- endif -%}
                {%- if link.links != blank -%}
                {% render 'tgtp-mega-menu', mega_menu: link, index: index, menu_parent: link %}
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="right-icons">
        <div class="search">
          <button class="search-btn icon">
            {{ 'icon-header-search.svg' | inline_asset_content }}
          </button>
        </div>
        <div>
          <a href="{{ routes.account_url }}" class="icon account__link">
            {{ 'icon-header-user.svg' | inline_asset_content }}
          </a>
        </div>
        <div class="cart">
          <a href="{{ routes.cart_url }}" class="icon cart__link" id="cart-icon-bubble">
            {%- if cart != empty -%}
              <div class="cart-count-bubble">
                {%- if cart.item_count < 100 -%}
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                {%- endif -%}
                <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
              </div>
            {%- endif -%}
            {{ 'icon-header-cart.svg' | inline_asset_content }}
          </a>
        </div>
      </div>
    </div>
    <div class="header-contents--SP">
      <div class="header-contents header-contents--left">
        {%- if section.settings.mobile_hamburger_icon_position == 'left' -%}
          <button class="hamburger icon">
            {{ 'icon-header-hamburger.svg' | inline_asset_content }}
          </button>
        {%- endif -%}
        {%- if section.settings.mobile_search_icon_position == 'left' -%}
          <div class="search">
            <button class="search-btn icon">
              {{ 'icon-header-search.svg' | inline_asset_content }}
            </button>
          </div>
        {%- endif -%}
        {%- if section.settings.mobile_cart_icon_position == 'left' -%}
          <div class="cart">
            <a href="{{ routes.cart_url }}" class="icon cart__link" id="cart-icon-bubble-sp">
              {%- if cart != empty -%}
                <div class="cart-count-bubble">
                  {%- if cart.item_count < 100 -%}
                    <span aria-hidden="true">{{ cart.item_count }}</span>
                  {%- endif -%}
                  <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
                </div>
              {%- endif -%}
              {{ 'icon-header-cart.svg' | inline_asset_content }}
            </a>
          </div>
        {%- endif -%}
      </div>
      <div class="logo">
        <a href="{{ routes.root_url }}" class="logo__link">
          {%- if section.settings.logo_image != blank -%}
            <img
              src="{{ section.settings.logo_image | image_url: 'master' }}"
              srcset="{{ section.settings.logo_image | image_url: width: section.settings.logo_image.width }} 1x, {{ section.settings.logo_image | image_url: width: section.settings.logo_image.width }} 2x"
              width="{{ section.settings.logo_image.width }}"
              height="{{ section.settings.logo_image.height }}"
              alt="{{ section.settings.logo_image.alt | default: shop.name | escape }}"
              class="logo-img"
            >
          {%- else -%}
            <img
              src="{{ 'relive_logo_2_200x@2x.png' | asset_url }}"
              alt="{{ shop.name | escape }}"
              class="logo-img"
            >
          {%- endif -%}
        </a>
      </div>
      <div class="header-contents header-contents--right">
        {%- if section.settings.enable_language_handle -%}
          <div class="desktop-localization-wrapper">
            {%- if section.settings.enable_language_handle and localization.available_countries.size > 1 -%}
              <localization-form class="small-hide medium-hide" data-prevent-hide>
                {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
                  <div>
                    <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                    {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
                  </div>
                {%- endform -%}
              </localization-form>
            {% endif %}

            {%- if section.settings.enable_language_handle and localization.available_languages.size > 1 -%}
              <localization-form class="small-hide medium-hide" data-prevent-hide>
                {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
                  <div>
                    <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                    {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
                  </div>
                {%- endform -%}
              </localization-form>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.mobile_search_icon_position == 'right' -%}
          <div class="search">
            <button class="search-btn icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19.5299 18.4694L14.8358 13.7763C16.1963 12.1429 16.8748 10.0478 16.73 7.92694C16.5852 5.80607 15.6283 3.82268 14.0584 2.38935C12.4885 0.95602 10.4264 0.183113 8.30115 0.231413C6.1759 0.279713 4.15108 1.1455 2.64791 2.64867C1.14474 4.15184 0.27895 6.17666 0.23065 8.30191C0.18235 10.4272 0.955257 12.4892 2.38859 14.0591C3.82191 15.629 5.80531 16.5859 7.92618 16.7307C10.047 16.8755 12.1421 16.1971 13.7755 14.8366L18.4686 19.5306C18.5383 19.6003 18.621 19.6556 18.7121 19.6933C18.8031 19.731 18.9007 19.7504 18.9992 19.7504C19.0978 19.7504 19.1954 19.731 19.2864 19.6933C19.3775 19.6556 19.4602 19.6003 19.5299 19.5306C19.5995 19.4609 19.6548 19.3782 19.6925 19.2872C19.7302 19.1961 19.7497 19.0985 19.7497 19C19.7497 18.9015 19.7302 18.8039 19.6925 18.7128C19.6548 18.6218 19.5995 18.5391 19.5299 18.4694ZM1.74924 8.5C1.74924 7.16498 2.14512 5.85993 2.88682 4.7499C3.62852 3.63987 4.68272 2.77471 5.91612 2.26381C7.14953 1.75292 8.50673 1.61925 9.8161 1.8797C11.1255 2.14015 12.3282 2.78303 13.2722 3.72703C14.2162 4.67103 14.8591 5.87377 15.1195 7.18314C15.38 8.49251 15.2463 9.84971 14.7354 11.0831C14.2245 12.3165 13.3594 13.3707 12.2493 14.1124C11.1393 14.8541 9.83426 15.25 8.49924 15.25C6.70964 15.248 4.9939 14.5362 3.72846 13.2708C2.46302 12.0053 1.75122 10.2896 1.74924 8.5Z" fill="white"/></svg>
            </button>
          </div>
        {%- endif -%}
        {%- if section.settings.mobile_cart_icon_position == 'right' -%}
          <div class="cart">
            <a href="{{ routes.cart_url }}" class="icon cart__link" id="cart-icon-bubble-sp">
