            </a>
          </div>
        {%- endif -%}
        {%- if section.settings.mobile_hamburger_icon_position == 'right' -%}
          <button class="hamburger icon">
            <svg width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg">
