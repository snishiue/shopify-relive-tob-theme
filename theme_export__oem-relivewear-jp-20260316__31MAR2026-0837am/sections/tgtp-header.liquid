            </svg>
          </button>
        {%- endif -%}
      </div>
    </div>
    <form action="/search" method="get" class="search-form">
      <div class="searchbar">
        <input type="text" name="q" placeholder="検索" aria-label="Search">
        <button type="submit" class="icon">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19.5306 18.4693L14.8365 13.7762C16.1971 12.1428 16.8755 10.0478 16.7307 7.92691C16.5859 5.80604 15.629 3.82265 14.0591 2.38932C12.4892 0.955989 10.4271 0.183083 8.30188 0.231383C6.17663 0.279683 4.15181 1.14547 2.64864 2.64864C1.14547 4.15181 0.279683 6.17663 0.231383 8.30188C0.183083 10.4271 0.955989 12.4892 2.38932 14.0591C3.82265 15.629 5.80604 16.5859 7.92691 16.7307C10.0478 16.8755 12.1428 16.1971 13.7762 14.8365L18.4693 19.5306C18.539 19.6003 18.6218 19.6556 18.7128 19.6933C18.8038 19.731 18.9014 19.7504 19 19.7504C19.0985 19.7504 19.1961 19.731 19.2871 19.6933C19.3782 19.6556 19.4609 19.6003 19.5306 19.5306C19.6003 19.4609 19.6556 19.3782 19.6933 19.2871C19.731 19.1961 19.7504 19.0985 19.7504 19C19.7504 18.9014 19.731 18.8038 19.6933 18.7128C19.6556 18.6218 19.6003 18.539 19.5306 18.4693ZM1.74997 8.49997C1.74997 7.16495 2.14585 5.8599 2.88755 4.74987C3.62925 3.63984 4.68346 2.77467 5.91686 2.26378C7.15026 1.75289 8.50746 1.61922 9.81683 1.87967C11.1262 2.14012 12.3289 2.78299 13.2729 3.727C14.2169 4.671 14.8598 5.87374 15.1203 7.18311C15.3807 8.49248 15.2471 9.84968 14.7362 11.0831C14.2253 12.3165 13.3601 13.3707 12.2501 14.1124C11.14 14.8541 9.83499 15.25 8.49997 15.25C6.71037 15.248 4.99463 14.5362 3.72919 13.2708C2.46375 12.0053 1.75196 10.2896 1.74997 8.49997Z" fill="#212121"/></svg>
