{{ 'tgtp-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .file-upload-container {
    margin-top: 10px;
    position: relative;
  }

  .file-upload-trigger {
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-block;
    text-align: center;
  }

  .file-upload-trigger:hover {
    opacity: 0.8;
  }

  .file-upload-counter {
    margin-top: 5px;
    font-size: 14px;
    color: #666;
    text-align: left;
  }

  .file-item {
    background-color: #f5f5f5;
    padding: 8px 12px;
    margin-bottom: 5px;
    border-radius: 4px;
    font-size: 14px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .file-preview-container {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #fff;
    border-radius: 4px;
    overflow: hidden;
  }

  .file-preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .file-preview.pdf-icon,
  .file-preview.file-icon {
    width: 24px;
    height: 24px;
    color: #666;
  }

  .file-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .file-name {
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-size {
    font-size: 12px;
    color: #666;
  }

  .file-remove-button {
    background: none;
    border: none;
    color: #999;
    font-size: 18px;
    cursor: pointer;
    padding: 0 5px;
    line-height: 1;
    transition: color 0.2s;
    flex-shrink: 0;
  }

  .file-remove-button:hover {
    color: #e74c3c;
  }

  .file-name-display:not(:empty) {
    display: block;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
    <div>
      {%- if section.settings.heading != blank -%}
        <h2 class="title center title-wrapper--no-top-margin inline-richtext {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="font-size: {{ section.settings.heading_size }}px;">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="center" style="margin-bottom: 50px; font-size: 14px;">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      <form class="formrun" action="{{ section.settings.formrun_action }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="uid" value="{{ customer.id }}">
        <input type="hidden" name="user_agent" id="design-formrun-user-agent">
        <input type="hidden" name="screen_size" id="design-formrun-screen-size">
        <input type="hidden" name="platform" id="design-formrun-platform">

        <div class="tgtp-contact-field-container">
          <label>お名前</label>
          <span class="required">必須</span>
          <div class="tgtp-contact-field">
            <input name="お名前" type="text" data-formrun-required>
          </div>
          <div class="error-message" data-formrun-show-if-error="お名前" hidden>お名前を入力してください</div>
        </div>

        <div class="tgtp-contact-field-container">
          <label>メールアドレス</label>
          <span class="required">必須</span>
          <div class="tgtp-contact-field">
            <input name="メールアドレス" type="text" data-formrun-type="email" data-formrun-required>
          </div>
          <div class="error-message" data-formrun-show-if-error="メールアドレス" hidden>メールアドレスを正しく入力してください</div>
        </div>

        <div class="tgtp-contact-field-container">
          <label>依頼内容</label>
          <span class="required">必須</span>
          <div class="tgtp-contact-field tgtp-contact-field-selecter">
            <select name="依頼内容" data-formrun-required>
              <option value="">選択してください</option>
              <option value="チラシ・フライヤー">チラシ・フライヤー</option>
              <option value="ポスター">ポスター</option>
              <option value="バナー画像">バナー画像</option>
              <option value="名刺">名刺</option>
              <option value="パッケージ">パッケージ</option>
              <option value="SNS用画像">SNS用画像</option>
              <option value="その他">その他</option>
            </select>
          </div>
          <div class="error-message" data-formrun-show-if-error="依頼内容" hidden>依頼内容を選択してください</div>
        </div>

        <div class="tgtp-contact-field-container">
          <label>希望サイズ・仕様</label>
          <div class="tgtp-contact-field">
            <input name="希望サイズ・仕様" type="text" placeholder="例：A4サイズ、横向き">
          </div>
        </div>

        <div class="tgtp-contact-field-container">
          <label>希望納期</label>
          <div class="tgtp-contact-field">
            <input name="希望納期" type="date" style="padding: 1.4rem; width: 100%; font-size: 1.6rem; color: #333;">
          </div>
        </div>

        <div class="tgtp-contact-field-container">
          <label>参考画像</label>
          <div class="file-upload-container">
            <input type="file" name="design_file1" id="design-hidden-file1" style="display:none;">
            <input type="file" name="design_file2" id="design-hidden-file2" style="display:none;">
            <input type="file" name="design_file3" id="design-hidden-file3" style="display:none;">
            <input type="file" id="design-file-upload-input" class="file-input" accept=".jpg, .jpeg, .png, .pdf, .ai, .psd" style="display: none;" multiple>
            <div class="file-upload-trigger" onclick="document.getElementById('design-file-upload-input').click()">
              <img
                src="https://cdn.shopify.com/s/files/1/0624/3994/8365/files/Group_191.png?v=1746582425"
                alt="ファイルを選択"
                class="file-upload-icon"
                width="178"
                height="178"
              >
            </div>
            <div class="file-upload-counter design-file-counter">0/3 ファイル選択中</div>
            <div id="design-file-name-display" class="file-name-display"></div>
          </div>
          <div class="form-warning">
            参考にしたいデザインや素材があれば添付してください。添付可能なファイル容量は合計300MBまでです。最大3つまでのファイルをアップロードできます。
          </div>
        </div>

        <div class="tgtp-contact-field-container">
          <label>デザインの詳細・要望</label>
          <span class="required">必須</span>
          <div>
            <textarea class="tgtp-contact-field tgtp-textarea" name="デザインの詳細・要望" data-formrun-required placeholder="色味、テイスト、掲載したいテキスト、ターゲット層など、できるだけ詳しくご記入ください。"></textarea>
          </div>
          <div class="error-message" data-formrun-show-if-error="デザインの詳細・要望" hidden>デザインの詳細・要望を入力してください</div>
        </div>

        <div class="tgtp-contact-field-container privacy-consent center">
          <div class="tgtp-select-container input">
            <input type="checkbox" id="design-privacy-consent" name="個人情報利用同意" data-formrun-required>
            <label for="design-privacy-consent">{{ 'templates.contact.form.agree_privacy' | t }}</label>
          </div>
          <div class="error-message" data-formrun-show-if-error="個人情報利用同意" hidden>同意してください</div>
        </div>

        <div class="_formrun_gotcha">
          <style media="screen">._formrun_gotcha {position:absolute!important;height:1px;width:1px;overflow:hidden;}</style>
          <label for="_formrun_gotcha_design">If you are a human, ignore this field</label>
          <input type="text" name="_formrun_gotcha" id="_formrun_gotcha_design" tabindex="-1">
        </div>

        <div class="contact__button center">
          <button type="submit" class="button" data-formrun-error-text="未入力の項目があります" data-formrun-submitting-text="送信中..." style="padding: 0 5rem">
            送信する
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var form = document.querySelector('.section-{{ section.id }}-padding .formrun');
    if (!form) return;

    var submitButton = form.querySelector('button[type="submit"]');
    var privacyCheckbox = document.getElementById('design-privacy-consent');
    var requiredFields = form.querySelectorAll('[data-formrun-required]');
    var errorMessages = {};

    requiredFields.forEach(function(field) {
      var fieldName = field.getAttribute('name');
      var errorElement = form.querySelector('[data-formrun-show-if-error="' + fieldName + '"]');
      if (errorElement) {
        errorMessages[fieldName] = errorElement;
      }
    });

    function checkRequiredFields() {
      var allFieldsValid = true;

      requiredFields.forEach(function(field) {
        var isValid = true;

        if (field.tagName === 'INPUT') {
          if (field.getAttribute('data-formrun-type') === 'email') {
            isValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field.value.trim());
          } else if (field.type === 'checkbox') {
            isValid = field.checked;
          } else {
            isValid = field.value.trim() !== '';
          }
        } else if (field.tagName === 'SELECT') {
          isValid = field.value !== '';
        } else if (field.tagName === 'TEXTAREA') {
          isValid = field.value.trim() !== '';
        }

        if (!isValid) {
          allFieldsValid = false;
        }
      });

      submitButton.disabled = !allFieldsValid;
      submitButton.classList.toggle('disabled', !allFieldsValid);
    }

    checkRequiredFields();

    requiredFields.forEach(function(field) {
      field.addEventListener('input', checkRequiredFields);
      field.addEventListener('change', checkRequiredFields);
    });

    form.addEventListener('submit', function(event) {
      var hasError = false;

      Object.values(errorMessages).forEach(function(element) {
        element.hidden = true;
      });

      requiredFields.forEach(function(field) {
        var fieldName = field.getAttribute('name');
        var isValid = true;

        if (field.tagName === 'INPUT') {
          if (field.getAttribute('data-formrun-type') === 'email') {
            isValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field.value.trim());
          } else if (field.type === 'checkbox') {
            isValid = field.checked;
          } else {
            isValid = field.value.trim() !== '';
          }
        } else if (field.tagName === 'SELECT') {
          isValid = field.value !== '';
        } else if (field.tagName === 'TEXTAREA') {
          isValid = field.value.trim() !== '';
        }

        if (!isValid && errorMessages[fieldName]) {
          errorMessages[fieldName].hidden = false;
          hasError = true;
        }
      });

      if (hasError) {
        event.preventDefault();
        var firstError = document.querySelector('[data-formrun-show-if-error]:not([hidden])');
        if (firstError) {
          firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    });
  });

  // ファイルアップロード処理
  (function() {
    var designFiles = [];
    var fileInput = document.getElementById('design-file-upload-input');
    if (!fileInput) return;

    fileInput.addEventListener('change', function() {
      var maxFiles = 3;
      var newFiles = Array.from(this.files);
      designFiles = designFiles.concat(newFiles);

      if (designFiles.length > maxFiles) {
        alert('ファイルは最大' + maxFiles + 'つまで選択できます。');
        designFiles = designFiles.slice(0, maxFiles);
      }

      updateDesignFileDisplay();
    });

    function updateDesignFileDisplay() {
      var counter = document.querySelector('.design-file-counter');
      var display = document.getElementById('design-file-name-display');
      var trigger = fileInput.closest('.file-upload-container').querySelector('.file-upload-trigger');

      counter.textContent = designFiles.length + '/3 ファイル選択中';
      display.innerHTML = '';

      designFiles.forEach(function(file, index) {
        var fileItem = document.createElement('div');
        fileItem.className = 'file-item';

        var previewContainer = document.createElement('div');
        previewContainer.className = 'file-preview-container';

        var isImage = file.type.startsWith('image/');

        if (isImage) {
          var preview = document.createElement('img');
          preview.className = 'file-preview';
          var reader = new FileReader();
          reader.onload = (function(img) {
            return function(e) { img.src = e.target.result; };
          })(preview);
          reader.readAsDataURL(file);
          previewContainer.appendChild(preview);
        } else {
          var fileIcon = document.createElement('div');
          fileIcon.className = 'file-preview file-icon';
          fileIcon.innerHTML = '<svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>';
          previewContainer.appendChild(fileIcon);
        }

        var fileInfo = document.createElement('div');
        fileInfo.className = 'file-info';

        var fileName = document.createElement('span');
        fileName.className = 'file-name';
        fileName.textContent = file.name;

        var fileSize = document.createElement('span');
        fileSize.className = 'file-size';
        fileSize.textContent = formatDesignFileSize(file.size);

        var removeButton = document.createElement('button');
        removeButton.className = 'file-remove-button';
        removeButton.innerHTML = '&times;';
        removeButton.setAttribute('aria-label', 'ファイルを削除');
        removeButton.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          designFiles.splice(index, 1);
          updateDesignFileDisplay();
        });

        fileInfo.appendChild(fileName);
        fileInfo.appendChild(fileSize);
        fileItem.appendChild(previewContainer);
        fileItem.appendChild(fileInfo);
        fileItem.appendChild(removeButton);
        display.appendChild(fileItem);
      });

      if (trigger) {
        trigger.classList.toggle('file-selected', designFiles.length > 0);
      }

      ['design-hidden-file1', 'design-hidden-file2', 'design-hidden-file3'].forEach(function(id, i) {
        var hiddenInput = document.getElementById(id);
        var dt = new DataTransfer();
        if (designFiles[i]) {
          dt.items.add(designFiles[i]);
        }
        hiddenInput.files = dt.files;
      });
    }

    function formatDesignFileSize(bytes) {
      if (bytes === 0) return '0 Bytes';
      var k = 1024;
      var sizes = ['Bytes', 'KB', 'MB', 'GB'];
      var i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }
  })();

  document.addEventListener('DOMContentLoaded', function() {
    var ua = navigator.userAgent;
    var platform = navigator.platform;
    var screenSize = screen.width + 'x' + screen.height;

    var uaEl = document.getElementById('design-formrun-user-agent');
    var pfEl = document.getElementById('design-formrun-platform');
    var ssEl = document.getElementById('design-formrun-screen-size');
    if (uaEl) uaEl.value = ua;
    if (pfEl) pfEl.value = platform;
    if (ssEl) ssEl.value = screenSize;
  });
</script>

{% schema %}
{
  "name": "TGTP Design Contact",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "見出し",
      "default": "デザイン制作依頼フォーム"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.heading_size.label",
      "default": 28
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文"
    },
    {
      "type": "text",
      "id": "formrun_action",
      "label": "formrun アクションURL",
      "info": "formrunのフォームURLを設定してください"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "TGTP Design Contact"
    }
  ]
}
{% endschema %}
