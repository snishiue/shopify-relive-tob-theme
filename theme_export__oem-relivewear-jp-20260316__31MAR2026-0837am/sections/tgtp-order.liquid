{{ 'tgtp-customer.css' | asset_url | stylesheet_tag }}


{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="order section-{{ section.id }}-padding page-width">
  <div class="center">
    <h2 class="customer__title" style="font-size: 22px; margin-bottom: 0;">{{ 'customer.orders.title' | t }}</h2>
    <h2 style="font-size: 22px; margin-top: 0;">{{ order.name }}</h2>
  </div>

  <div class="order-details-container">
    <div>
      <div>
      {%- assign order_date = order.created_at | time_tag: format: 'date_at_time' -%}
      <h2 style="font-size: 18px; border-bottom: 1px solid #9E9E9E; padding-bottom: 8px;">{{ 'customer.order.date_html' | t: date: order_date }}</h2>
      {%- if order.cancelled -%}
        {%- assign cancelled_at = order.cancelled_at | time_tag: format: 'date_at_time' -%}
        <p>{{ 'customer.order.cancelled_html' | t: date: cancelled_at }}</p>
        <p>{{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}</p>
      {%- endif -%}

      {% comment %} <table role="table" class="order-details" style="box-shadow: none; width: 100%;"> {% endcomment %}
        {%- for line_item in order.line_items -%}
          <table role="table" class="order-history-table order-details-table" style="width: 100%;">
            <caption class="visually-hidden">
              {{ 'customer.order.title' | t: name: order.name }}
            </caption>
            <tbody role="rowgroup">
              <tr role="row" class="">
                <td headers="RowProductCode ColumnTotal" role="cell" colspan="2" data-label="{{ 'customer.order.subtotal' | t }}" style="width: 100%; text-align: left; padding: 5px 0; text-decoration: underline;">
                  <a href="{{ line_item.url }}" style="text-decoration: underline; color: #000000;">{{ line_item.title | escape }}</a>
                </td>
              </tr>
              {% comment %} <tr role="row">
                <th id="ColumnProductCode" scope="col" role="columnheader">{{ 'customer.order.product_code' | t }}</th>
                <td
                  id="RowProductCode"
                  role="cell"
                  headers="ColumnProductCode"
                  data-label="{{ 'customer.order.product_code' | t }}"
                >
                  {{ line_item.sku }}
                </td>
              </tr> {% endcomment %}
              <tr role="row">
                <th id="ColumnPrice" scope="col" role="columnheader">{{ 'customer.order.price' | t }}</th>
                <td headers="RowProductCode ColumnPrice" role="cell" data-label="{{ 'customer.order.price' | t }}">
                  {{ line_item.final_price | money }}
                </td>
              </tr>
              <tr role="row">
                <th id="ColumnQuantity" scope="col" role="columnheader">{{ 'customer.order.quantity' | t }}</th>
                <td headers="RowProductCode ColumnQuantity" role="cell" data-label="{{ 'customer.order.quantity' | t }}">
                  {{ line_item.quantity }}
                </td>
              </tr>
              <tr role="row" class="subtotal-row">
                <td headers="RowProductCode ColumnTotal" role="cell" colspan="2" data-label="{{ 'customer.order.subtotal' | t }}" style="width: 100%; text-align: right;">
                  <a style="font-size: 10px;">{{ 'customer.order.subtotal' | t }}</a>
                  <a style="font-size: 16px;">{{ line_item.final_line_price | money }}</a>
                </td>
              </tr>
            </tbody>
          </table>
        {%- endfor -%}
        <div class="" style="text-align: -webkit-right;">
          <table role="rowgroup" class="">
            <tr role="row">
              <td id="RowSubtotal" role="rowheader" scope="row" colspan="4">
                {{ 'customer.order.subtotal' | t }}
              </td>
              <td headers="RowSubtotal" role="cell" data-label="{{ 'customer.order.subtotal' | t }}">
                {{ order.line_items_subtotal_price | money }}
              </td>
            </tr>
            {%- if order.cart_level_discount_applications != blank -%}
              <tr role="row">
                {%- for discount_application in order.cart_level_discount_applications -%}
                  <td id="RowDiscount" role="rowheader" scope="row" colspan="4">
                    {{ 'customer.order.discount' | t }}

                    <span class="cart-discount">
                      <span class="svg-wrapper">
                        {{- 'icon-discount.svg' | inline_asset_content -}}
                      </span>
                      {{- discount_application.title | escape -}}
                    </span>
                  </td>
                  <td headers="RowDiscount" role="cell" data-label="{{ 'customer.order.discount' | t }}">
                    <div>
                      <span>-{{ discount_application.total_allocated_amount | money }}</span>
                      <span class="cart-discount">
                        <span class="svg-wrapper">
                          {{- 'icon-discount.svg' | inline_asset_content -}}
                        </span>
                        {{- discount_application.title | escape -}}
                      </span>
                    </div>
                  </td>
                {%- endfor -%}
              </tr>
            {%- endif -%}
            {%- for tax_line in order.tax_lines -%}
              <tr role="row">
                <td id="RowTax" role="rowheader" scope="row" colspan="4">
                  {{ 'customer.order.tax' | t }}
                </td>
                <td
                  headers="RowTax"
                  role="cell"
                  data-label="{{ 'customer.order.tax' | t }}"
                >
                  ({{ tax_line.price | money }})
                </td>
              </tr>
            {%- endfor -%}
            {%- for shipping_method in order.shipping_methods -%}
              <tr role="row">
                <td id="RowShipping" role="rowheader" scope="row" colspan="4">
                  {{ 'customer.order.shipping' | t }}
                </td>
                <td
                  headers="RowShipping"
                  role="cell"
                  data-label="{{ 'customer.order.shipping' | t }} ({{ shipping_method.title | escape }})"
                >
                  {{ shipping_method.price | money }}
                </td>
              </tr>
            {%- endfor -%}
            {%- if order.total_duties -%}
              <tr role="row">
                <td id="RowDuties" role="rowheader" scope="row" colspan="4">{{ 'customer.order.total_duties' | t }}</td>
                <td headers="RowDuties" role="cell" data-label="{{ 'customer.order.total_duties' | t }}">
                  {{ order.total_duties | money }}
                </td>
              </tr>
            {%- endif -%}
            {%- if order.total_refunded_amount > 0 -%}
              <tr role="row">
                <td id="RowTotalRefund" role="rowheader" scope="row" colspan="3">
                  {{ 'customer.order.total_refunded' | t }}
                </td>
                <td
                  headers="RowTotalRefund"
                  role="cell"
                  colspan="2"
                  data-label="{{ 'customer.order.total_refunded' | t }}"
                >
                  -{{ order.total_refunded_amount | money_with_currency }}
                </td>
              </tr>
            {%- endif -%}
            <tr role="row" style="justify-content: space-between; border-top: 1px solid #E0E0E0; border-bottom: 1px solid #E0E0E0;">
              <td id="RowTotal" role="rowheader" scope="row" colspan="3">{{ 'customer.order.total_net_amount' | t }}</td>
              <td style="font-size: 22px;" headers="RowTotal" role="cell" colspan="2" data-label="{{ 'customer.order.total_net_amount' | t }}">
                {{ order.total_net_amount | money_with_currency }}
              </td>
            </tr>
          </table>
        </div>
      {% comment %} </table> {% endcomment %}
    </div>
    </div>
    <div>
      <div>
        <h2 style="font-size: 18px; border-bottom: 1px solid #9E9E9E; padding-bottom: 8px;">{{ 'customer.order.shipping_address' | t }}</h2>
        <p style="margin: 24px 0; color: #212121;">
          {{ 'customer.order.fulfillment_status' | t }}:
          {{ order.fulfillment_status_label }}
        </p>
        <div class="vertical-line" style="margin-bottom: 48px;">
          <h3 style="font-size: 16px; color: #212121; margin-bottom: 8px; cursor: default;">{{ order.shipping_address.last_name }} {{ order.shipping_address.first_name }}</h3>
          <a style="font-size: 14px; cursor: default;">{{ order.shipping_address.zip }}</a><br>
          <a style="font-size: 14px; cursor: default;">{{ order.shipping_address.province }}{{ order.shipping_address.city }}{{ order.shipping_address.address1 }}{{ order.shipping_address.address2 }}</a>
        </div>
      </div>
      <div>
        <h2 style="font-size: 18px; border-bottom: 1px solid #9E9E9E; padding-bottom: 8px;">{{ 'customer.order.billing_address' | t }}</h2>
        <p style="margin: 24px 0; color: #212121;">
          {{ 'customer.order.payment_status' | t }}:
          {{ order.financial_status_label }}
        </p>
        <div class="vertical-line">
          <h3 style="font-size: 16px; color: #212121; margin-bottom: 8px; cursor: default;">{{ order.billing_address.last_name }} {{ order.billing_address.first_name }}</h3>
          <a style="font-size: 14px; cursor: default;">{{ order.billing_address.zip }}</a><br>
          <a style="font-size: 14px; cursor: default;">{{ order.billing_address.province }}{{ order.billing_address.city }}{{ order.billing_address.address1 }}{{ order.billing_address.address2 }}</a>
        </div>
      </div>
    </div>
  </div>
  <div class="center" style="width: 100%;">
    <a class="tgtp-button" style="margin-top: 5rem; background-color: #fff; color: #212121; border: 1px solid #BDBDBD; border-radius: 25px;" href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a>
  </div>
</div>

{%  style  %} 
  .order-history-table {
    display: table;

  }

  .order-history-table th {
    width: 14%;
    display: inline-block;
  }

  .order-history-table td {
    /* width: 80%; */
    text-align: left;
  }

  .order-history-table .subtotal-row td {
    display: block;
    width: 100%;
    background-color: #F5F5F5;
    padding: 8px;
    margin-top: 10px;
  }

/* 通常の行のスタイル */
.order-history-table tr:not(.subtotal-row) {
  display: flex;
  align-items: center;
  gap: 12px;
}

.order-details-table tr:last-child {
  width: 100%;
}

.order-details-table tr:last-child td {
  width: 100%;
  padding: 8px 16px;
  background-color: #F5F5F5;
  margin-top: 5px;
}

/* .order-details-container {
  display: flex;
} */

@media screen and (max-width: 749px) {
  .order-history-table th {
    width: 32%;
  }
}

@media screen and (min-width: 989px) {
  .order-details-container {
    display: flex;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "TGTP Order",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "TGTP Order"
    }
  ]
}
{% endschema %}
