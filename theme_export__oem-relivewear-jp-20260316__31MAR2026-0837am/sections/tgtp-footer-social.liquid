  "name": "TGTP_footer_social",
  "limit": 1,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_display_flex",
      "label": "Align text and icons side by side"
    },
    {
      "type": "checkbox",
      "id": "enable_text_link",
      "label": "テキストにもリンクを設定する",
      "default": false,
      "info": "テキストにもリンクを設定する場合は、1つ目のリンクのみが有効になります。"
    },
    {
      "type": "text",
      "id": "text",
      "label": "text"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "text color"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "margin top",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "padding x",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_x",
      "label": "mobile padding x",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },
    {
      "type": "header",
      "content": "icon-1"
    },
    {
      "type": "image_picker",
      "id": "icon_image_1",
      "label": "icon"
    },
    {
      "type": "number",
      "id": "icon_width_1",
      "label": "icon width",
      "default": 20
    },
    {
      "type": "number",
      "id": "mobile_icon_width_1",
      "label": "mobile icon width",
      "default": 20
    },
    {
      "type": "url",
      "id": "icon_link_1",
      "label": "link"
    },
    {
      "type": "header",
      "content": "icon-2"
    },
    {
      "type": "image_picker",
      "id": "icon_image_2",
      "label": "icon"
    },
    {
      "type": "number",
      "id": "icon_width_2",
      "label": "icon width",
      "default": 20
    },
    {
      "type": "number",
      "id": "mobile_icon_width_2",
      "label": "mobile icon width",
      "default": 20
    },
    {
      "type": "url",
      "id": "icon_link_2",
      "label": "link"
    },
    {
      "type": "header",
      "content": "icon-3"
    },
    {
      "type": "image_picker",
      "id": "icon_image_3",
      "label": "icon"
    },
    {
      "type": "number",
      "id": "icon_width_3",
      "label": "icon width",
      "default": 20
    },
    {
      "type": "number",
      "id": "mobile_icon_width_3",
      "label": "mobile icon width",
      "default": 20
    },
    {
      "type": "url",
      "id": "icon_link_3",
      "label": "link"
    }
  ],
  "presets": [
    {
      "name": "TGTP_footer_social"
    }
  ]
}
{% endschema %}
