{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

<div class="tgtp-collection page-width page-width--narrow section-{{ section.id }}-padding">
  {%- if section.settings.show_collection_image and collection.image -%}
    <div class="collection-hero__image-container">
      <img
        srcset="
          {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
          {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
          {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
          {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
          {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
          {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
          {{ collection.image | image_url }} {{ collection.image.width }}w
        "
        src="{{ collection.image | image_url: width: 750 }}"
        sizes="(max-width: 749px) 100vw, (min-width: {{ settings.page_width }}px) {{ settings.page_width }}px, 100vw"
        alt="{{ collection.image.alt | escape }}"
        width="{{ collection.image.width }}"
        height="{{ collection.image.height }}"
        class="collection-image"
      >
    </div>
  {%- endif -%}
  <h1 class="center">
    {{- collection.title | escape -}}
  </h1>

  <div>
    {%- if section.settings.show_collection_description and collection.description != blank -%}
      <div class="collection-description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>

{% style %}
  :root {
    --collection_title_alignment: {{ section.settings.title_alignment }};
    --collection_padding_content_top: {{ section.settings.padding_content_top }}px;
  }

  .tgtp-collection h1 {
    text-align: var(--collection_title_alignment);
    margin-bottom: var(--collection_padding_content_top);
  }

  .collection-description {
    margin-bottom: 20px;
  }

  .collection-hero__image-container {
    width: 100%;
    position: relative;
    overflow: hidden;
    margin: 0 auto;
    text-align: center;
    margin-bottom: 30px;
  }

  .collection-image {
    width: auto;
    max-width: 100%;
    height: auto;
    display: inline-block;
    object-fit: contain;
    max-height: 500px;
  }

  @media screen and (max-width: 749px) {
    .collection-hero__image-container {
      margin-bottom: 20px;
    }

    .collection-image {
      max-height: none;
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }

    .tgtp-collection h1 {
      font-size: 24px;
      margin-bottom: 15px;
    }

    .collection-description {
      font-size: 14px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "タイトルの配置",
      "options": [
        {
          "value": "left",
          "label": "左寄せ"
        },
        {
          "value": "center",
          "label": "中央寄せ"
        },
        {
          "value": "right",
          "label": "右寄せ"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label",
      "info": "t:sections.main-collection-banner.settings.show_collection_image.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_content_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "タイトル下の余白",
      "default": 36
    }
  ]
}
{% endschema %}
