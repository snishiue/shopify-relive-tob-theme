{{ 'tgtp-promotional-materials.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <h1 class="promotional-materials__title">{{ section.settings.title }}</h1>

  <div class="promotional-materials__controls">
    <div class="promotional-materials__search">
      <input
        type="text"
        id="promotional-materials-search"
        class="promotional-materials__search-input"
        placeholder="商品名・素材名で検索"
      >
    </div>
    <div class="promotional-materials__filters">
      <select id="promotional-materials-category" class="promotional-materials__select">
        <option value="">すべて</option>
        <option value="product">商品別素材</option>
        <option value="common">共通素材</option>
      </select>
      <select id="promotional-materials-sort" class="promotional-materials__select">
        <option value="newest">新着順</option>
        <option value="title">名前順</option>
      </select>
    </div>
  </div>

  <div class="promotional-materials__grid" id="promotional-materials-grid"></div>

  <p class="promotional-materials__loading" id="promotional-materials-loading">読み込み中...</p>

  <p class="promotional-materials__empty" id="promotional-materials-empty" style="display: none;">
    該当する素材が見つかりませんでした。
  </p>

  <nav class="promotional-materials__pagination" id="promotional-materials-pagination" style="display: none;" aria-label="ページネーション">
    <button class="promotional-materials__pagination-btn" id="pagination-prev" disabled>&lsaquo;</button>
    <div class="promotional-materials__pagination-pages" id="pagination-pages"></div>
    <button class="promotional-materials__pagination-btn" id="pagination-next">&rsaquo;</button>
  </nav>
</div>

<script>
  (function() {
    var API_URL = 'https://{{ shop.permanent_domain }}/api/2025-01/graphql.json';
    var TOKEN = {{ section.settings.storefront_token | default: 'bec2347eda52ba05f4ab7b60308db7fb' | json }};
    var PER_PAGE = {{ section.settings.per_page | default: 12 }};
    var LABELS = ['ファイル1', 'ファイル2', 'ファイル3', 'ファイル4', 'ファイル5'];
    var FILE_KEYS = ['image1', 'image2', 'image3', 'image4', 'image5'];
    var COMMON_THUMBNAIL = {{ 'tgtp-common-material-thumbnail.svg' | asset_url | json }};
    var DOWNLOAD_ICON = '<svg class="promotional-materials__download-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';

    var grid = document.getElementById('promotional-materials-grid');
    var loadingMsg = document.getElementById('promotional-materials-loading');
    var emptyMsg = document.getElementById('promotional-materials-empty');
    var searchInput = document.getElementById('promotional-materials-search');
    var categorySelect = document.getElementById('promotional-materials-category');
    var sortSelect = document.getElementById('promotional-materials-sort');
    var paginationNav = document.getElementById('promotional-materials-pagination');
    var prevBtn = document.getElementById('pagination-prev');
    var nextBtn = document.getElementById('pagination-next');
    var pagesContainer = document.getElementById('pagination-pages');
    if (!grid) return;

    var allItems = [];
    var currentPage = 1;
    var filteredItems = [];

    function buildQuery(sortKey, reverse) {
      return '{ metaobjects(type: "promotional_materials", first: 250, sortKey: "' + sortKey + '", reverse: ' + reverse + ') { nodes { handle updatedAt fields { key value reference { ... on Product { title handle featuredImage { url(transform: { maxWidth: 400 }) } } ... on MediaImage { image { url(transform: { maxWidth: 400 }) } } ... on GenericFile { url } } } } } }';
    }

    function getSortParams() {
      var sortBy = sortSelect ? sortSelect.value : 'newest';
      if (sortBy === 'title') {
        return { sortKey: 'handle', reverse: false };
      }
      return { sortKey: 'updated_at', reverse: true };
    }

    function parseItems(nodes) {
      return nodes.map(function(node) {
        var fields = {};
        node.fields.forEach(function(f) { fields[f.key] = f; });

        var productRef = fields['product_reference'];
        var product = productRef && productRef.reference ? productRef.reference : null;
        var isProduct = product && product.title;

        var thumbnail = null;
        if (isProduct && product.featuredImage) {
          thumbnail = product.featuredImage.url;
        } else if (fields['image1'] && fields['image1'].reference) {
          var ref = fields['image1'].reference;
          thumbnail = ref.image ? ref.image.url : null;
        }
        if (!thumbnail && !isProduct) {
          thumbnail = COMMON_THUMBNAIL;
        }
        
        var files = FILE_KEYS.map(function(key, i) {
          var f = fields[key];
          if (!f || !f.reference) return { label: LABELS[i], url: null };
          var ref = f.reference;
          var url = ref.url || (ref.image ? ref.image.url : null);
          return { label: LABELS[i], url: url };
        });

        return {
          handle: node.handle,
          updatedAt: node.updatedAt,
          isProduct: !!isProduct,
          productTitle: isProduct ? product.title : null,
          productHandle: isProduct ? product.handle : null,
          title: isProduct ? product.title : node.handle.replace(/-/g, ' '),
          thumbnail: thumbnail,
          files: files
        };
      });
    }

    function renderCard(item) {
      var imgHtml;
      var isCommonThumb = !item.isProduct && item.thumbnail === COMMON_THUMBNAIL;
      if (isCommonThumb) {
        imgHtml = '<div class="promotional-materials__card-common"><img src="' + COMMON_THUMBNAIL + '" alt="' + escapeHtml(item.title) + '" width="108" height="108" loading="lazy"></div>';
      } else if (item.thumbnail) {
        imgHtml = '<img src="' + item.thumbnail + '" alt="' + escapeHtml(item.title) + '" width="400" loading="lazy">';
      } else {
        imgHtml = '<div class="promotional-materials__card-placeholder"></div>';
      }

      var buttonsHtml = item.files.map(function(f) {
        if (f.url) {
          return '<a href="' + f.url + '" download class="promotional-materials__download-btn">'
            + '<span class="promotional-materials__btn-label">' + f.label + '</span>' + DOWNLOAD_ICON + '</a>';
        }
        return '<span class="promotional-materials__download-btn promotional-materials__download-btn--disabled">'
          + '<span class="promotional-materials__btn-label">' + f.label + '</span>' + DOWNLOAD_ICON + '</span>';
      }).join('');

      return '<div class="promotional-materials__card">'
        + '<div class="promotional-materials__card-image">' + imgHtml + '</div>'
        + '<div class="promotional-materials__card-info">'
        + '<h2 class="promotional-materials__card-title">' + escapeHtml(item.title) + '</h2>'
        + '<div class="promotional-materials__card-buttons">' + buttonsHtml + '</div>'
        + '</div></div>';
    }

    function escapeHtml(str) {
      var div = document.createElement('div');
      div.appendChild(document.createTextNode(str));
      return div.innerHTML;
    }

    function getFiltered() {
      var query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      var category = categorySelect ? categorySelect.value : '';

      return allItems.filter(function(item) {
        var matchesSearch = !query
          || item.handle.toLowerCase().indexOf(query) !== -1
          || item.title.toLowerCase().indexOf(query) !== -1
          || (item.productHandle && item.productHandle.toLowerCase().indexOf(query) !== -1);
        var matchesCategory = !category
          || (category === 'product' && item.isProduct)
          || (category === 'common' && !item.isProduct);
        return matchesSearch && matchesCategory;
      });
    }

    function renderPagination(totalPages) {
      pagesContainer.innerHTML = '';
      if (totalPages <= 1) {
        paginationNav.style.display = 'none';
        return;
      }
      paginationNav.style.display = '';
      for (var i = 1; i <= totalPages; i++) {
        var btn = document.createElement('button');
        btn.className = 'promotional-materials__pagination-page' + (i === currentPage ? ' is-active' : '');
        btn.textContent = i;
        btn.setAttribute('data-page', i);
        pagesContainer.appendChild(btn);
      }
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
    }

    function render() {
      filteredItems = getFiltered();
      var totalPages = Math.max(1, Math.ceil(filteredItems.length / PER_PAGE));
      if (currentPage > totalPages) currentPage = totalPages;

      var start = (currentPage - 1) * PER_PAGE;
      var end = start + PER_PAGE;
      var pageItems = filteredItems.slice(start, end);

      grid.innerHTML = pageItems.map(renderCard).join('');
      emptyMsg.style.display = filteredItems.length === 0 ? '' : 'none';
      renderPagination(totalPages);
    }

    function goToPage(page) {
      currentPage = page;
      render();
      grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /* Throttle download clicks */
    grid.addEventListener('click', function(e) {
      var btn = e.target.closest('.promotional-materials__download-btn:not(.promotional-materials__download-btn--disabled)');
      if (!btn || btn.classList.contains('promotional-materials__download-btn--throttled')) {
        if (btn && btn.classList.contains('promotional-materials__download-btn--throttled')) e.preventDefault();
        return;
      }
      btn.classList.add('promotional-materials__download-btn--throttled');
      setTimeout(function() { btn.classList.remove('promotional-materials__download-btn--throttled'); }, 750);
    });

    pagesContainer.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-page]');
      if (btn) goToPage(parseInt(btn.getAttribute('data-page'), 10));
    });
    prevBtn.addEventListener('click', function() { if (currentPage > 1) goToPage(currentPage - 1); });
    nextBtn.addEventListener('click', function() {
      var totalPages = Math.ceil(filteredItems.length / PER_PAGE);
      if (currentPage < totalPages) goToPage(currentPage + 1);
    });

    if (searchInput) searchInput.addEventListener('input', function() { currentPage = 1; fetchAndRender(); });
    if (categorySelect) categorySelect.addEventListener('change', function() { currentPage = 1; fetchAndRender(); });
    if (sortSelect) sortSelect.addEventListener('change', function() { currentPage = 1; fetchAndRender(); });

    function fetchAndRender() {
      var params = getSortParams();
      var query = buildQuery(params.sortKey, params.reverse);
      loadingMsg.style.display = '';
      grid.innerHTML = '';
      fetch(API_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Shopify-Storefront-Access-Token': TOKEN
        },
        body: JSON.stringify({ query: query })
      })
      .then(function(res) { return res.json(); })
      .then(function(json) {
        loadingMsg.style.display = 'none';
        if (json.data && json.data.metaobjects && json.data.metaobjects.nodes) {
          allItems = parseItems(json.data.metaobjects.nodes);
          render();
        } else {
          emptyMsg.style.display = '';
          console.error('Storefront API error:', json.errors || json);
        }
      })
      .catch(function(err) {
        loadingMsg.style.display = 'none';
        emptyMsg.style.display = '';
        console.error('Fetch error:', err);
      });
    }

    fetchAndRender();
  })();
</script>

{% schema %}
{
  "name": "Promo Materials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "ページタイトル",
      "default": "販促素材"
    },
    {
      "type": "text",
      "id": "storefront_token",
      "label": "Storefront API トークン"
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 6,
      "max": 48,
      "step": 3,
      "label": "1ページあたりの表示件数",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Promo Materials"
    }
  ]
}
{% endschema %}
