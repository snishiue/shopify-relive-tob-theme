{{ 'tgtp-swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{'tgtp-swiper-bundle.min.js' | asset_url}}"></script>
{{ 'section-tgtp-character.css' | asset_url | stylesheet_tag }}

<div class="tgtp-character tgtp-character--{{ section.id }}">
  {% render 'tgtp-section__heading' %}
  <div class="tgtp-character-list{% if section.settings.scroll_type == 'auto_scroll' %} auto-scroll{% elsif section.settings.scroll_type == 'auto_scroll' %} manual-scroll{% else %} swiper{% endif %}" 
       style="--scroll-speed: {{ section.settings.scroll_speed }}s;">
    {% if section.settings.scroll_type == 'swiper'%}
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide ">
            <a class="tgtp-character-item" href="{{ block.settings.collection.url }}">
              {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'eager' }}
            </a>
          </div>
        {%- endfor -%}
        {%- for block in section.blocks -%}
          <div class="swiper-slide ">
            <a class="tgtp-character-item" href="{{ block.settings.collection.url }}">
              {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'eager' }}
            </a>
          </div>
        {%- endfor -%}
      </div>
    {% else %}
      {%- for block in section.blocks -%}
        <a class="tgtp-character-item" href="{{ block.settings.collection.url }}">
          {{ block.settings.image | image_url: width: 160 | image_tag }}
        </a>
      {%- endfor -%}
      {%- for block in section.blocks -%}
        <a class="tgtp-character-item" href="{{ block.settings.collection.url }}">
          {{ block.settings.image | image_url: width: 160 | image_tag }}
        </a>
      {%- endfor -%}
    {% endif %}
</div>

{% if section.settings.scroll_type == 'swiper'%}
  <script>
    const initSwiper = () => {
      const mySwiper = new Swiper('.tgtp-character--{{ section.id }} .swiper', {
        speed: {{section.settings.scroll_speed | times: 100 }},
        slidesPerView: 'auto',
        loop: true,
        spaceBetween: "{{ section.settings.column_gap_sp }}",
        freeMode: {
          enabled: true,
          sticky: false,
          momentum: false,
        },
        loopAdditionalSlides: 1,
        autoplay: {
          delay: 0,
          disableOnInteraction: true,
          pauseOnMouseEnter: true,
        },
         breakpoints: {
          750: {
            spaceBetween: "{{ section.settings.column_gap }}",
          }
        }
      });
    };
  
    window.addEventListener('load', function(){
      initSwiper(); // ページ読み込み後に初期化
    });
  </script>
{% endif %}

{% schema %}
  {
    "name": "TGTP collection list",
    "tag": "section",
    "class": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
