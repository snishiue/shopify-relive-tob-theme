        "type": "range",
        "id": "section_upper_padding",
        "label": "セクション上部 間隔",
        "min": 8,
        "max": 80,
        "step": 4,
        "default": 60,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_upper_padding_sp",
        "label": "セクション上部 間隔 スマホ",
        "min": 8,
        "max": 80,
        "step": 4,
        "default": 60,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_lower_padding",
        "label": "セクション下部 間隔",
        "min": 8,
        "max": 80,
        "step": 4,
        "default": 60,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_lower_padding_sp",
        "label": "セクション下部 間隔 スマホ",
