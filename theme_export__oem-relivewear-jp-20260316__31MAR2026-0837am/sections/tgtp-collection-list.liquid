      {
        "type": "text",
        "id": "background_color_grad",
        "info": "背景色(グラデーションを指定したい場合)",
        "label": "背景色(グラデーション)",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "背景画像"
      },
      {
        "type": "header",
        "content": "コンテンツ情報"
      },
      {
        "type": "range",
        "id": "caption_upper_padding",
        "label": "キャプション上部 間隔",
        "min": 0,
        "max": 80,
        "step": 4,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "caption_upper_padding_sp",
        "label": "キャプション上部 間隔 スマホ",
        "min": 0,
        "max": 80,
        "step": 4,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "コレクション一覧情報"
      },
      {
        "type": "checkbox",
        "id": "auto_alide",
        "label": "自動スライドを有効にする",
        "default": true
      },
      {
        "type": "range",
        "id": "slide_wait",
        "label": "スライドの待機時間",
        "min": 0,
        "max": 10,
        "step": 0.1,
        "default": 3,
        "unit": "秒"
      },
      {
        "type": "range",
        "id": "slide_time",
        "label": "スライドの切り替わりに要する時間",
        "min": 0,
        "max": 3,
        "step": 0.1,
        "default": 0.3,
        "unit": "秒"
      },
      {
        "type": "checkbox",
        "id": "card_content",
        "label": "コレクションの見出しを表示する",
        "default": false
      },
      {
        "type": "range",
        "id": "display_desktop",
        "label": "PC時の表示数",
        "min": 1,
        "max": 8,
        "step": 1,
        "default": 5,
        "unit": "枚"
      },
      {
        "type": "range",
        "id": "item_margin_desktop",
        "label": "PC時のアイテム間のマージン",
        "min": 0,
        "max": 24,
        "step": 1,
        "default": 8,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "list_dot_desktop",
