    "blocks": [
      {
        "type": "tgtp_collection_item",
        "name": "TGTP collection",
        "settings": [
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "個別に表示させたい画像"
