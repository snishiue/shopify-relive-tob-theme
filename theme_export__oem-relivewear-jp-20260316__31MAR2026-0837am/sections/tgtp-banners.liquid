      },
      {
        "type": "header",
        "content": "コンテンツ情報"
      },
      {
        "type": "range",
        "id": "caption_upper_padding",
        "label": "キャプション上部 間隔",
        "min": 0,
        "max": 80,
        "step": 4,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "caption_upper_padding_sp",
        "label": "キャプション上部 間隔 スマホ",
        "min": 0,
        "max": 80,
        "step": 4,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "コレクション一覧情報"
      },
      {
        "type": "checkbox",
        "id": "card_content",
        "label": "コレクションの見出しを表示する",
        "default": false
      },
      {
        "type": "range",
        "id": "display_desktop",
        "label": "PC時の表示数",
        "min": 1,
        "max": 8,
        "step": 1,
        "default": 5,
