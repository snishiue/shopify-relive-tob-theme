{{ 'tgtp-banners.css' | asset_url | stylesheet_tag }}

{% comment %} セクションの表示数がブロックの表示数より多い場合はブロックの表示数に合わせる {% endcomment %}
{%  liquid 
  assign display_desktop = section.settings.display_desktop
%}


{% style %}
  #shopify-section-{{ section.id }} .tgtp-banners__list {
    {% if section.settings.section_width == 0 %}
      max-width: none;
    {% else %}
      max-width: {{ section.settings.section_width }}px;
      margin: auto;
    {% endif %}
    padding: 0 {{ section.settings.item_margin_desktop }}px;
    {% if section.settings.display_desktop > section.blocks.size %}
      display: flex;
      justify-content: center;
    {% else %}
      grid-template-columns: repeat({{ display_desktop }}, 1fr);
    {% endif %}
  }
  #shopify-section-{{ section.id }} .tgtp-banners__item {
    margin: 0 {{ section.settings.item_margin_desktop }}px;
  }
  {% if section.settings.banner_border_radius %}
    #shopify-section-{{ section.id }} .tgtp-banners__item img {
      border-radius: {{ section.settings.banner_border_radius }}px;
    }
  {% endif %}


  #shopify-section-{{ section.id }} .tgtp-banners__item {
    width: 100%;
    max-width: 326px;
  }



  @media screen and (max-width: 749px) {
    {% if section.settings.is_full_width_moblie %}
      #shopify-section-{{ section.id }} .tgtp-banners__list{
        display: flex;
        flex-direction: column;
        gap: 18px;
      }
      #shopify-section-{{ section.id }} .tgtp-banners__item {
        max-width: none;
        max-width: initial;
      }
    {% endif %}

    #shopify-section-{{ section.id }} .tgtp-banners__item {
      {% if section.settings.section_width_sp == 0 %}
        max-width: none;
        max-width: initial;
        margin: 0;
      {% else %}
        max-width: {{ section.settings.section_width_sp }}px;
        margin: auto;
      {% endif %}
      margin: 0 {{ section.settings.item_margin_mobile }}px;
      grid-template-columns: repeat({{ section.settings.display_mobile }}, 1fr);
    }
  }

{% endstyle %}

<div id="shopify-section-{{ section.id }}" class="tgtp-banners {% if section.settings.page_width %} page-width {% endif %} color-{{ section.settings.color_scheme }}">
  {% render 'tgtp-section__heading' %}
  <div class="tgtp-banners__body">
    <ul
      class="tgtp-banners__list"
    >
      {%- for block in section.blocks -%}
        <li
          id="tgtp-banners__item-{{ forloop.index }}"
          class="tgtp-banners__item"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
          {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}

          {%- liquid
            assign card_image = block.settings.image
            assign media_aspect_ratio = block.settings.image_ratio
            assign columns = columns
            assign placeholder_image = placeholder_image
            assign card__content = section.settings.card_content

            assign ratio = 1
            if card_image and media_aspect_ratio == 'portrait'
              assign ratio = 0.8
            elsif card_image and media_aspect_ratio == 'adapt'
              assign ratio = card_image.aspect_ratio
            endif
            if ratio == 0 or ratio == null
              assign ratio = 1
            endif
            assign card_color_scheme = settings.card_color_scheme
            assign card_style = settings.card_style
            if wrapper_class == null or wrapper_class == 'none'
              assign card_color_scheme = settings.collection_card_color_scheme
              assign card_style = settings.collection_card_style
            endif
          -%}

          <a href="{{ block.settings.url }}" class="tgtp-banners__link">
            <div class="card-wrapper animate-arrow {% if wrapper_class and wrapper_class != 'none' %}{{ wrapper_class }}{% else %}collection-card-wrapper{% endif %}">
              <div
                class="
                  card
                  card--{{ card_style }}
                  {% if card_collection.featured_image %} card--media{% else %} card--text{% endif %}
                  {% if card_style == 'card' %} color-{{ card_color_scheme }} gradient{% endif %}
                  {% if extend_height %} card--extend-height{% endif %}
                  {% if card_collection.featured_image == nil and card_style == 'card' %} ratio{% endif %}
                "
                style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
              >
                <div
                  class="card__inner {% if card_style == 'standard' %}color-{{ card_color_scheme }} gradient{% endif %}{% if card_collection.featured_image or card_style == 'standard' %} ratio{% endif %}"
                  style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
                >
                  <div class="card__media">
                    <div class="media media--transparent media--hover-effect">
                      <img
                        srcset="
                          {%- if card_image.width >= 165 -%}{{ card_image | image_url: width: 165 }} 165w,{%- endif -%}
                          {%- if card_image.width >= 330 -%}{{ card_image | image_url: width: 330 }} 330w,{%- endif -%}
                          {%- if card_image.width >= 535 -%}{{ card_image | image_url: width: 535 }} 535w,{%- endif -%}
                          {%- if card_image.width >= 750 -%}{{ card_image | image_url: width: 750 }} 750w,{%- endif -%}
                          {%- if card_image.width >= 1000 -%}{{ card_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                          {%- if card_image.width >= 1500 -%}{{ card_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                          {%- if card_image.width >= 3000 -%}{{ card_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                          {{ card_image | image_url }} {{ card_image.width }}w
                        "
                        src="{{ card_image | image_url: width: 1500 }}"
                        sizes="
                          (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: columns }}px,
                          (min-width: 750px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %},
                          calc(100vw - 3rem)
                        "
                        alt="{{ card_image.alt | escape }}"
                        height="{{ card_image.height }}"
                        width="{{ card_image.width }}"
                        loading="lazy"
                        class="motion-reduce"
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>
            </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>


{% schema %}
  {
    "name": "TGTP banners",
    "tag": "section",
    "class": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "header",
        "content": "セクション情報"
      },
      {
        "type": "checkbox",
        "id": "page_width",
        "label": "ページ幅に合わせる",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "use_default_padding",
        "label": "デフォルトの間隔を適用",
        "default": true
      },
      {
        "type": "range",
        "id": "section_width",
        "label": "セクション最大幅",
        "min": 0,
        "max": 1200,
        "step": 40,
        "default": 960,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_width_sp",
        "label": "セクション最大幅 スマホ",
        "min": 0,
        "max": 720,
        "step": 40,
        "default": 400,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_upper_padding",
        "label": "セクション上部 間隔",
        "min": 8,
        "max": 80,
        "step": 4,
        "default": 60,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_upper_padding_sp",
        "label": "セクション上部 間隔 スマホ",
        "min": 8,
        "max": 80,
        "step": 4,
        "default": 60,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_lower_padding",
        "label": "セクション下部 間隔",
        "min": 8,
        "max": 80,
        "step": 4,
        "default": 60,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_lower_padding_sp",
        "label": "セクション下部 間隔 スマホ",
        "min": 8,
        "max": 80,
        "step": 4,
        "default": 60,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "column_gap",
        "label": "グリッド左右間隔",
        "min": 0,
        "max": 40,
        "step": 4,
        "default": 24,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "column_gap_sp",
        "label": "グリッド左右間隔 スマホ",
        "min": 0,
        "max": 40,
        "step": 4,
        "default": 24,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "row_gap",
        "label": "グリッド上下間隔",
        "min": 0,
        "max": 40,
        "step": 4,
        "default": 24,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "row_gap_sp",
        "label": "グリッド上下間隔 スマホ",
        "min": 0,
        "max": 40,
        "step": 4,
        "default": 24,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "タイトル情報"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Collection list"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Subheading"
      },
      {
        "type": "checkbox",
        "id": "heading_iscenter",
        "label": "見出し中央寄せ",
