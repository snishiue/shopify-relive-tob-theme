      },
      {
        "type": "range",
        "id": "item_margin_desktop",
        "label": "PC時のアイテム間のマージン",
        "min": 0,
        "max": 24,
        "step": 1,
        "default": 8,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "display_mobile",
        "label": "スマホ時の表示数",
        "min": 1,
        "max": 5,
        "step": 1,
