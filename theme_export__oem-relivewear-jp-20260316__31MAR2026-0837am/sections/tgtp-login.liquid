{{ 'tgtp-customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  :root {
    --button-radius: {{ section.settings.button_radius }}px;
  }
{%- endstyle -%}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

<div class="customer login section-{{ section.id }}-padding">
  <h1 id="recover" class="center" tabindex="-1">
    {{ 'customer.recover_password.title' | t }}
  </h1>
  <div>
    <p>
      {{ 'customer.recover_password.subtext' | t }}
    </p>

    {%- form 'recover_customer_password' -%}
      {% assign recover_success = form.posted_successfully? %}
      <div class="tgtp-field-container">
        <label for="CustomerEmail" class="order">
          {{ 'customer.login_page.email' | t }}
          <span class="required">
            {{ 'customer.login_page.required' | t }}
          </span>
        </label>
        <div class="tgtp-field">
          <input
          type="email"
          value=""
          name="email"
          id="RecoverEmail"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="RecoverEmail-email-error"
            autofocus
          {% endif %}
          placeholder="{{ 'customer.login_page.email' | t }}"
        >
        </div>
      </div>
      {%- if form.errors -%}
        <small id="RecoverEmail-email-error" class="form__message">
          <span class="svg-wrapper">
            {{- 'icon-error.svg' | inline_asset_content -}}
          </span>
          {{ form.errors.messages.form }}
        </small>
      {%- endif -%}

      <button style="border-radius: var(--button-radius); width: 100%;">
        {{ 'customer.login_page.submit' | t }}
      </button>

      <a class="tgtp-back tgtp-button" href="#login">
        {{ 'customer.login_page.cancel' | t }}
      </a>
    {%- endform -%}
  </div>

  <h1 id="login" tabindex="-1" class="center">
    {{ 'customer.login_page.title' | t }}
  </h1>
  <div>
    {%- if recover_success == true -%}
      <h3 class="form__message" tabindex="-1" autofocus>
        <span class="svg-wrapper">
          {{- 'icon-success.svg' | inline_asset_content -}}
        </span>
        {{ 'customer.recover_password.success' | t }}
      </h3>
    {%- endif -%}
    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        {% comment %} <h2 class="form__message" tabindex="-1" autofocus>
          <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
          <span class="svg-wrapper">
            {{- 'icon-error.svg' | inline_asset_content -}}
          </span>
          {{ 'templates.contact.form.error_heading' | t }}
        </h2> {% endcomment %}
        {%- for field in form.errors -%}
          {%- if field == 'form' -%}
            <p class="error">{{ form.errors.messages[field] }}</p>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
        <section name="sign-in-with-shop-provider">
          {{ shop | login_button: hide_button: hide_shop_login_button }}

          {%- unless hide_shop_login_button -%}
            <p>
              {{ 'customer.login_page.alternate_provider_separator' | t }}
            </p>
          {%- endunless -%}
        </section>
      {%- endif -%}

      <div class="tgtp-field-container">
        <label for="CustomerEmail" class="order">
          {{ 'customer.login_page.email' | t }}
          <span class="required">
            {{ 'customer.login_page.required' | t }}
          </span>
        </label>
        <div class="tgtp-field">
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            {% if form.errors contains 'form' %}
              aria-invalid="true"
            {% endif %}
            placeholder="{{ section.settings.email_placeholder }}"
          >
        </div>
      </div>

      {%- if form.password_needed -%}
        <div class="tgtp-field-container">
          <label for="CustomerPassword" class="order">
            {{ 'customer.login_page.password' | t }}
            <span class="required">
              {{ 'customer.login_page.required' | t }}
            </span>
          </label>
          <div class="tgtp-field">
            <input
              type="password"
              value=""
              name="customer[password]"
              id="CustomerPassword"
              autocomplete="current-password"
              {% if form.errors contains 'form' %}
                aria-invalid="true"
              {% endif %}
              placeholder="{{ section.settings.password_placeholder }}"
            >
          </div>
        </div>
      {%- endif -%}

      <div class="center">
        <button class="button" style="border-radius: var(--button-radius); width: 100%;">
          {{ 'customer.login_page.sign_in' | t }}
        </button>
      </div>

      {%- if form.password_needed -%}
        <a href="#recover">
          {{ 'customer.login_page.forgot_password' | t }}
        </a>
      {%- endif -%}

      <div class="create-account">
        <h2 class="center">
          {{ 'customer.login_page.create_account_title' | t }}
        </h2>
        <p style="margin: 3rem 0 6rem;">
          {{ 'customer.login_page.create_account_description' | t }}
        </p>
        <div class="center">
          <a href="{{ routes.account_register_url }}" class="tgtp-button" style="width: 100%;">
            {{ 'customer.login_page.create_account' | t }}
          </a>
        </div>
      </div>
    {%- endform -%}
  </div>

  {%- if shop.checkout.guest_login -%}
    <div>
      <hr>
      <h2>{{ 'customer.login_page.guest_title' | t }}</h2>

      {%- form 'guest_login' -%}
        <button>
          {{ 'customer.login_page.guest_continue' | t }}
        </button>
      {%- endform -%}
    </div>
  {%- endif -%}
</div>
{%- style -%}
  /* .form {
    width: 100%;
  } */
{%- endstyle -%}

{% schema %}
{
  "name": "TGTP Login",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:sections.main-login.shop_login_button.enable",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "password_placeholder",
      "label": "Password Placeholder",
      "default": "Password"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "ボタンの傍線の色",
      "default": "#000"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button Radius",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "TGTP Login"
    }
  ]
}
{% endschema %}
