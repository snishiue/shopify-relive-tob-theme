{"sections":{"tgtp_section_kv_zp8eJW":{"type":"tgtp-section-kv","blocks":{"slide_bxQpED":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/OEM_4.png","link":""}},"slide_FJybqk":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/OEM_6.png","link":""}},"slide_FxFeXH":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/2602_rilive_bleague.jpg","link":""}},"slide_phUbDJ":{"type":"slide","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/FVCR_-13.webp","link":""}},"slide_wnfb6t":{"type":"slide","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/test_fv.png","link":""}},"slide_g9Lm8V":{"type":"slide","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/2602_rilive_bleague_1ad89ab6-f97d-4364-a257-51507b5a78bf.webp","link":""}},"slide_w6rpmJ":{"type":"slide","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/2602_rilive_bleague_1ad89ab6-f97d-4364-a257-51507b5a78bf.webp","link":""}}},"block_order":["slide_bxQpED","slide_FJybqk","slide_FxFeXH","slide_phUbDJ","slide_wnfb6t","slide_g9Lm8V","slide_w6rpmJ"],"custom_css":[".tgtp-section-kv .swiper-pagination-bullet-active {background-color: #ba2b20 !important;}"],"name":"TGTP KV","settings":{"text_color":"","button_text_color":"","button_background_color":"","background_color":"","background_color_mobile":"","background_type":"loop","background_loop_size_pc":"","background_loop_size_smp":"","content_padding_x_enable":true,"content_width_type":"full","manual_content_width_enable":false,"content_width":1024,"padding_top":0,"padding_bottom":36,"margin_top":0,"margin_bottom":0,"padding_top_mobile":0,"padding_bottom_mobile":20,"margin_top_mobile":0,"margin_bottom_mobile":0,"enabled_autoplay":false,"autoplay_delay":3000}},"rich_text_MxN4KV":{"type":"rich-text","blocks":{"heading_pjJMGL":{"type":"heading","settings":{"heading":"リライブシャツについて","heading_size":"h1"}},"text_8Yarnn":{"type":"text","settings":{"text":"<p><strong>「着るだけで筋肉をサポートする」新発想のウェア<\/strong><\/p><p>リライブシャツは、健康雑貨として開発された機能性ウェアです。東洋医学の『身体のツボ』に着目し、複数の鉱石を特殊配合したインクをプリントしています。 介護や現場作業などの「肉体労働時の身体のサポート」を目的として開発され、現在ではトップアスリートのコンディション調整から、ご高齢者の日常的なサポート、デスクワーカーのリフレッシュまで、幅広い層に支持されています。 メディアやSNSでも大きな反響を呼んでおり、「試着すれば違いがわかる」高い成約率が、多くの販売店様から評価されています。<\/p>"}}},"block_order":["heading_pjJMGL","text_8Yarnn"],"name":"About","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":68,"padding_bottom":64}},"rich_text_XEWBn7":{"type":"rich-text","blocks":{"heading_KR3mL8":{"type":"heading","settings":{"heading":"サービス利用メリット","heading_size":"h1"}},"text_DPpfCG":{"type":"text","settings":{"text":"<p>当サイトにご登録いただくことで、スムーズかつ好条件でリライブシャツをお取り扱いいただけます。<\/p><ul><li><strong>魅力的な卸価格と高利益率<\/strong><br\/>法人会員様限定の卸売価格を適用。貴社のビジネスの利益最大化に貢献します。<\/li><li><strong>小ロットからの柔軟な仕入れ<\/strong><br\/>テストマーケティングにも最適な小ロットからの発注に対応。在庫リスクを抑えてスタートできます。<\/li><li><strong>24時間いつでもオンライン発注<\/strong><br\/>本ECからいつでもご発注が可能。発注業務の負担を大幅に削減します。<\/li><\/ul>"}},"button_dLjaaJ":{"type":"button","settings":{"button_label":"ログインする","button_link":"\/account\/login","button_style_secondary":true,"button_label_2":"","button_link_2":"","button_style_secondary_2":false}},"button_XCiWWc":{"type":"button","settings":{"button_label":"新規会員登録","button_link":"\/account\/register","button_style_secondary":false,"button_label_2":"","button_link_2":"","button_style_secondary_2":false}}},"block_order":["heading_KR3mL8","text_DPpfCG","button_dLjaaJ","button_XCiWWc"],"custom_css":["li {margin-top: 1rem;}"],"name":"service advantages","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":40,"padding_bottom":52}},"custom_liquid_fkw6Jq":{"type":"custom-liquid","custom_css":[],"name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  .features-container {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 2rem;\n    margin: 0 auto;\n    width: 100%;\n  }\n\n  .features-container h1,\n  .features-container p {\n    padding: 0 1.6rem;\n    margin: 0 auto;\n    max-width: calc(100% - 4rem);\n  }\n\n  .features-table-wrapper {\n    width: 100%;\n    max-width: 800px;\n    overflow-x: auto;\n    padding-left: 1.6rem;\n    padding-right: 1.6rem;\n  }\n\n  .features-table {\n    width: 100%;\n    min-width: 480px;\n    border-collapse: collapse;\n  }\n  \n  .features-table th,\n  .features-table td {\n    border: 1px solid #ccc;\n    padding: 12px 16px;\n    text-align: left;\n    font-size: 14px;\n    line-height: 1.6;\n  }\n  \n  .features-table th {\n    background-color: #000;\n    color: #fff;\n    text-align: center;\n    font-weight: bold;\n  }\n  \n  .features-table td:first-child {\n    font-weight: bold;\n    white-space: nowrap;\n    width: 160px;\n  }\n  \n  @media screen and (max-width: 749px) {\n    .features-table td:first-child {\n      white-space: normal;\n      width: auto;\n    }\n  }\n<\/style>\n<div class=\"features-container\">\n  <h1>リライブシャツの特徴（商材としての強み）<\/h1>\n  <p>なぜ、リライブシャツが「売れる」のか。取扱店様にとってのメリットをご紹介します。<\/p>\n\n  <div class=\"features-table-wrapper\">\n    <table class=\"features-table\">\n      <tr>\n        <th>特徴<\/th>\n      <th>詳細・販売時のメリット<\/th>\n    <\/tr>\n    <tr>\n      <td>試着時の動きやすさ<\/td>\n      <td>着用してすぐに「動きやすさ」を体感しやすいため、実店舗での試着・デモンストレーション販売と非常に相性が良い商材です。<\/td>\n    <\/tr>\n    <tr>\n      <td>確かな裏付け<\/td>\n      <td>独自開発の鉱石プリント技術は特許を取得しており（特許第6409143号等）、他社にはないオンリーワンの製品として差別化が図れます。<\/td>\n    <\/tr>\n    <tr>\n      <td>圧倒的な認知度<\/td>\n      <td>人気YouTube番組や各種メディアでの紹介実績が多数あり、指名買いや口コミでの広がりが期待できるため、集客のフックになります。<\/td>\n    <\/tr>\n    <tr>\n      <td>幅広いターゲット層<\/td>\n      <td>介護・医療従事者、運送業、アスリート、シニア層など、あらゆる世代・職業のお客様にアプローチが可能です。<\/td>\n    <\/tr>\n    <\/table>\n  <\/div>\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}},"tgtp_section_goods_Acjqdz":{"type":"tgtp-section-goods","settings":{"id":"","title":"","title_lower_margin":64,"title_lower_margin_sp":40,"heading_alternateimage_size":200,"heading_alternateimage_size_mobile":180,"subheading":"","heading_iscenter":true,"title_align":"left","enable_filter":true,"filter_tab_text_color":"","filter_tab_background_color":"","filter_tab_active_text_color":"","filter_tab_active_background_color":"","is_scroll_view_pc":false,"is_scroll_view_mobile":false,"scroll_view_min_width":240,"scroll_view_min_width_mobile":240,"is_history_view":false,"collection":"frontpage","products_to_show":12,"grid_column":4,"grid_column_mobile":2,"visible_product_price":true,"product_card_border":"","product_card_radius":0,"product_card_radius_mobile":0,"product_card_text_color":"#050505","product_card_background_color":"rgba(0,0,0,0)","product_card_padding":0,"product_card_padding_mobile":0,"product_card_gap":16,"product_card_gap_mobile":16,"product_card_title_font_size_pc":14,"product_card_title_font_size_mobile":14,"product_card_price_font_size_pc":15,"product_card_price_font_size_mobile":15,"product_tag_pos":"default","product_tag_text_color":"","product_tag_background_color":"","product_tag_border_color":"","product_tag_border_width":0,"visible_product_link":true,"product_link_text":"リンク","product_link_text_color":"","product_link_background_color":"","visible_product_add_cart":true,"product_add_cart_text_color":"","product_add_cart_background_color":"#e4e4e4","background_type":"loop","background_loop_size_pc":"","background_loop_size_smp":"","background_color":"#e4e4e4","view_more_enable":true,"view_more_text":"もっと見る","view_more_url":"shopify:\/\/collections\/all","view_more_text_color":"#000000","view_more_background_color":"#f5f5f5","content_padding_x_enable":true,"content_width_type":"manual","manual_content_width_enable":true,"content_width":1024,"padding_top":64,"padding_bottom":64,"padding_side":16,"padding_top_mobile":36,"padding_bottom_mobile":44,"padding_side_mobile":16}},"rich_text_UwcDhb":{"type":"rich-text","blocks":{"heading_9MxPCr":{"type":"heading","settings":{"heading":"ホールセールサイトの使い方","heading_size":"h1"}}},"block_order":["heading_9MxPCr"],"name":"About","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":72,"padding_bottom":16}},"rich_text_ATimMf":{"type":"rich-text","blocks":{"text_76V3QG":{"type":"text","settings":{"text":"<p>お取引開始までは、わずか4ステップ。すべてオンラインで完結します。<\/p><p>　<\/p><h2>1. 新規会員登録の申請<\/h2><p>「新規会員登録」ボタンより、貴社の企業情報や販売予定形態などをフォームにご入力の上、送信してください。<\/p><p>　<\/p><h2>2. 弊社での審査（8営業日）<\/h2><p>ご入力いただいた内容をもとに、審査を行わせていただきます。<\/p><p>　<\/p><h2>3. アカウント発行・ログイン<\/h2><p>審査通過後、ご登録メールアドレス宛にログイン用のIDとパスワードをご案内いたします。<\/p><p>　<\/p><h2>4. 特別価格でのご発注<\/h2><p>ログイン後、すぐに卸売価格での商品閲覧・カートからのご発注が可能となります。<\/p>"}}},"block_order":["text_76V3QG"],"name":"faq","settings":{"desktop_content_position":"center","content_alignment":"left","color_scheme":"","full_width":true,"padding_top":40,"padding_bottom":72}},"tgtp_sp_faq_VbX9Py":{"type":"tgtp-sp-faq","blocks":{"faq_q1":{"type":"faq","settings":{"faq_title":"<strong>個人事業主でも登録・仕入れは可能ですか？<\/strong>","faq_content":"<p>はい、開業届を出されている個人事業主様であればご登録・お取引が可能です。審査時に事業内容がわかるWebサイト等を確認させていただきます。<\/p>"}},"faq_q2":{"type":"faq","settings":{"faq_title":"<strong>最低発注数量（ミニマムロット）はありますか？<\/strong>","faq_content":"<p>初回・2回目以降ともに、1着から卸価格にてご提供しております。<\/p>"}},"faq_q3":{"type":"faq","settings":{"faq_title":"<strong>決済方法にはどのような種類がありますか？<\/strong>","faq_content":"<p>請求書払い、クレジットカード決済をご用意しております。<\/p>"}},"faq_q4":{"type":"faq","settings":{"faq_title":"<strong>送料はいくらかかりますか？<\/strong>","faq_content":"<p>ロット数に応じて送料は変動いたします。まずは会員登録をしていただきご希望の商品・ロット数で注文を進めていただきますと送料をご確認いただけます。<\/p>"}},"faq_q5":{"type":"faq","settings":{"faq_title":"<strong>不良品の返品・交換はできますか？<\/strong>","faq_content":"<p>返品・交換は原則お受けしておりません。万が一、お届けした商品に初期不良や品違いがあった場合は、商品到着後14日以内にご連絡ください。速やかに良品と交換させていただきます。<\/p>"}}},"block_order":["faq_q1","faq_q2","faq_q3","faq_q4","faq_q5"],"custom_css":[".faq-accordion__content {background-color: transparent;}"],"name":"TGTP FAQ","settings":{"FAQ_heading":"よくある質問","heading_size":28,"padding_top":72,"padding_bottom":72}},"rich_text_A8KnFb":{"type":"rich-text","blocks":{"heading_73pcbG":{"type":"heading","disabled":true,"settings":{"heading":"よくある質問","heading_size":"h1"}},"text_AbDJBg":{"type":"text","disabled":true,"settings":{"text":"<h3><strong>持病のある方や妊婦の方の着用について<\/strong><\/h3><p>ご不安な場合は、医師へ相談の上ご着用ください。<\/p>"}},"text_AQT4V6":{"type":"text","disabled":true,"settings":{"text":"<h3><strong>商品の種類、カラー、サイズを間違えて注文した<\/strong><\/h3><p>ご注文確定後の内容の変更はできかねます。<br\/>サイズ交換については商品到着後に交換のお手続きをお願いいたします。<\/p>"}},"text_4RaeeB":{"type":"text","disabled":true,"settings":{"text":"<h3><strong>サイズ交換について<\/strong><\/h3><p>商品がお手元に届いてから一週間は、返送時の送料のみお客様ご負担となりますが、サイズの交換を承っております。<\/p><p>【オンラインショップご注文者様】<br\/>商品と一緒にお届けしている同梱物の中に入っている”よくあるご質問”と記載してある用紙の裏面にある、”Q11 商品の返品交換の手続き方法”内のQRコードよりサイズ交換申請後、商品の返送をお願いいたします。<\/p><p>【お電話または代金引き換えでのご注文者様】<br\/>一緒に同梱されている“交換に関するご案内”と記載されている用紙に必要事項をご記入のうえ同梱いただき、商品の返送をお願いいたします。<\/p><p>※欠品中のサイズと交換をご希望の場合、<br\/>入荷次第の発送となるため、交換商品発送までお時間がかかる場合もございます。<br\/><br\/>※お客様ご自身で商品を加工(切る、縫う、記名等)された場合、交換、返品保証の対象外となりますので、ご注意ください。<\/p>"}},"button_cAtGLX":{"type":"button","settings":{"button_label":"ログインする","button_link":"\/account\/login","button_style_secondary":true,"button_label_2":"","button_link_2":"","button_style_secondary_2":false}},"button_fyEae7":{"type":"button","settings":{"button_label":"新規会員登録","button_link":"\/account\/register","button_style_secondary":false,"button_label_2":"","button_link_2":"","button_style_secondary_2":false}}},"block_order":["heading_73pcbG","text_AbDJBg","text_AQT4V6","text_4RaeeB","button_cAtGLX","button_fyEae7"],"name":"registration button","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":40,"padding_bottom":52}},"17731251377c63d1f8":{"type":"apps","blocks":{"paid_btob_api_block_f6nm4W":{"type":"shopify:\/\/apps\/paid-btob-api\/blocks\/block\/d21a2118-25ca-424f-9f3d-9d85852ccb33","settings":{"img":"200_200"}}},"block_order":["paid_btob_api_block_f6nm4W"],"se